# =============================================================================
# 2. Isolated pYIN worker
# =============================================================================
# The parent process calls this same file with --pyin-worker. The worker saves
# only its result and exits before the ordinary pipeline starts.

run_pyin_worker <- function(arguments) {
  if (length(arguments) != 9L) {
    stop("The internal pYIN worker received an invalid argument list.",
         call. = FALSE)
  }

  audio_path <- arguments[2]
  output_path <- arguments[3]
  minimum_f0 <- as.numeric(arguments[4])
  maximum_f0 <- as.numeric(arguments[5])
  frame_length <- as.integer(arguments[6])
  window_shift_ms <- as.numeric(arguments[7])
  resolution <- as.numeric(arguments[8])
  librosa_requirement <- arguments[9]

  if (!requireNamespace("reticulate", quietly = TRUE)) {
    stop(
      "The R package 'reticulate' is required. Run install.packages(\"reticulate\").",
      call. = FALSE
    )
  }

  if (!("py_require" %in% getNamespaceExports("reticulate"))) {
    stop(
      "Your reticulate package is too old. Run install.packages(\"reticulate\") ",
      "and restart RStudio.",
      call. = FALSE
    )
  }

  # Pin the extractor version so all recordings use the same implementation.
  reticulate::py_require(librosa_requirement)
  # Keep the waveform as a Python NumPy array. If convert = TRUE is used here,
  # reticulate may turn the waveform into an R numeric vector; passing that
  # vector back to librosa.pyin() is rejected because pYIN requires ndarray.
  librosa <- reticulate::import("librosa", convert = FALSE)
  numpy <- reticulate::import("numpy", convert = FALSE)

  loaded_audio <- librosa$load(
    audio_path,
    sr = NULL,
    mono = TRUE
  )

  # Python tuples use zero-based indexing. py_get_item() also guarantees that
  # the waveform remains an unconverted Python object.
  audio <- reticulate::py_get_item(loaded_audio, 0L)
  sample_rate <- as.numeric(reticulate::py_to_r(
    reticulate::py_get_item(loaded_audio, 1L)
  ))
  hop_length <- max(1L, as.integer(round(
    sample_rate * window_shift_ms / 1000
  )))

  pyin_result <- librosa$pyin(
    y = audio,
    fmin = minimum_f0,
    fmax = maximum_f0,
    sr = sample_rate,
    frame_length = frame_length,
    hop_length = hop_length,
    resolution = resolution,
    center = TRUE,
    fill_na = numpy$nan
  )

  f0 <- as.numeric(reticulate::py_to_r(
    reticulate::py_get_item(pyin_result, 0L)
  ))
  voiced_flag <- as.logical(reticulate::py_to_r(
    reticulate::py_get_item(pyin_result, 1L)
  ))
  voiced_probability <- as.numeric(reticulate::py_to_r(
    reticulate::py_get_item(pyin_result, 2L)
  ))

  if (!(length(f0) == length(voiced_flag) &&
        length(f0) == length(voiced_probability))) {
    stop("pYIN returned arrays with inconsistent lengths.", call. = FALSE)
  }

  voiced_flag[is.na(voiced_flag)] <- FALSE
  voiced_probability[!is.finite(voiced_probability)] <- NA_real_
  f0[!voiced_flag | !is.finite(f0) | f0 <= 0] <- NA_real_
  time <- (seq_along(f0) - 1L) * hop_length / sample_rate

  worker_result <- list(
    frames = data.frame(
      frame = seq_along(f0),
      time = time,
      f0_hz = f0,
      voiced_flag = voiced_flag,
      voiced_probability = voiced_probability,
      frame_duration = rep(hop_length / sample_rate, length(f0)),
      stringsAsFactors = FALSE
    ),
    extractor = "librosa.pyin",
    librosa_version = as.character(reticulate::py_to_r(
      reticulate::py_get_attr(librosa, "__version__")
    )),
    sample_rate_hz = sample_rate,
    frame_length_samples = frame_length,
    hop_length_samples = hop_length
  )

  saveRDS(worker_result, output_path, compress = TRUE)
}

script_arguments <- commandArgs(trailingOnly = TRUE)
if (length(script_arguments) > 0L && script_arguments[1] == "--pyin-worker") {
  tryCatch(
    {
      run_pyin_worker(script_arguments)
      quit(save = "no", status = 0L)
    },
    error = function(e) {
      message("pYIN worker failed: ", conditionMessage(e))
      quit(save = "no", status = 1L)
    }
  )
}


# =============================================================================
# 3. Note extraction and recording-level analysis
# =============================================================================

run_note_analysis <- function(settings, stage = "both") {
  # Bind the settings locally. The names match the original study script.
  list2env(settings$ANALYSIS, envir = environment())
  AUDIO_DIR <- settings$AUDIO_DIR
  CONFIG_FILE <- settings$CONFIG_FILE
  OUTPUT_DIR <- settings$OUTPUT_DIR
  CACHE_DIR <- settings$CACHE_DIR
  SCRIPT_FILE <- settings$SCRIPT_FILE
  REFERENCE_ID <- settings$REFERENCE_ID
  RUN_STAGE <- stage

  # -----------------------------------------------------------------------------
  # 2. PACKAGE CHECK
  # -----------------------------------------------------------------------------

  required_packages <- c("reticulate", "data.table", "ggplot2")
  missing_packages <- required_packages[
    !vapply(required_packages, requireNamespace, logical(1), quietly = TRUE)
  ]

  if (length(missing_packages) > 0L) {
    stop(
      "Install the following packages before running the analysis: ",
      paste(missing_packages, collapse = ", "),
      "\nRun: install.packages(c(",
      paste(sprintf("\"%s\"", missing_packages), collapse = ", "),
      "))",
      call. = FALSE
    )
  }


  # -----------------------------------------------------------------------------
  # 3. SMALL UTILITY FUNCTIONS
  # -----------------------------------------------------------------------------

  safe_median <- function(x) {
    x <- x[is.finite(x)]
    if (length(x) == 0L) return(NA_real_)
    stats::median(x)
  }

  safe_mean <- function(x) {
    x <- x[is.finite(x)]
    if (length(x) == 0L) return(NA_real_)
    mean(x)
  }

  make_odd <- function(x) {
    x <- max(1L, as.integer(round(x)))
    if (x %% 2L == 0L) x <- x + 1L
    x
  }

  safe_filename <- function(x) {
    gsub("[^A-Za-z0-9_-]", "_", x)
  }

  normalise_probability <- function(x) {
    x[!is.finite(x) | x < 0] <- 0
    total <- sum(x)
    if (total <= 0) return(rep(NA_real_, length(x)))
    x / total
  }

  weighted_quantile <- function(x, weights, probabilities) {
    keep <- is.finite(x) & is.finite(weights) & weights > 0
    x <- as.numeric(x[keep])
    weights <- as.numeric(weights[keep])

    if (length(x) == 0L) {
      return(rep(NA_real_, length(probabilities)))
    }
    if (length(x) == 1L) {
      return(rep(x, length(probabilities)))
    }

    order_index <- order(x)
    x <- x[order_index]
    weights <- weights[order_index]

    # Midpoint cumulative probabilities match the duration-weighted empirical
    # quantiles used in the event-level validation analysis.
    cumulative_probability <- (
      cumsum(weights) - 0.5 * weights
    ) / sum(weights)

    as.numeric(stats::approx(
      x = cumulative_probability,
      y = x,
      xout = probabilities,
      method = "linear",
      ties = "ordered",
      rule = 2
    )$y)
  }


  # -----------------------------------------------------------------------------
  # 4. CONFIGURATION TEMPLATE AND VALIDATION
  # -----------------------------------------------------------------------------

  create_config_template <- function(path, n_total = 34L) {
    if (n_total < 2L) stop("n_total must be at least 2.", call. = FALSE)

    ids <- c("R", sprintf("A%02d", seq_len(n_total - 1L)))
    filenames <- c("reference.wav", sprintf("A%02d.wav", seq_len(n_total - 1L)))

    template <- data.table::data.table(
      recording_id = ids,
      file_name = filenames,
      sa_hz = NA_real_,
      min_f0_hz = 70,
      max_f0_hz = 700,
      include = TRUE
    )

    data.table::fwrite(template, path)
  }

  if (!file.exists(CONFIG_FILE)) {
    create_config_template(CONFIG_FILE, n_total = 34L)
    stop(
      "A 34-recording template named '", CONFIG_FILE, "' has been created. ",
      "Enter the correct file name and Sa frequency for every recording, ",
      "then run the script again.",
      call. = FALSE
    )
  }

  config <- data.table::fread(CONFIG_FILE)

  required_columns <- c(
    "recording_id", "file_name", "sa_hz", "min_f0_hz", "max_f0_hz",
    "include"
  )

  missing_columns <- setdiff(required_columns, names(config))
  if (length(missing_columns) > 0L) {
    stop(
      "The configuration file is missing: ",
      paste(missing_columns, collapse = ", "),
      call. = FALSE
    )
  }

  # fread() may store whole-number columns as integer vectors. Coerce all
  # acoustic-analysis settings explicitly before validation or pYIN processing.
  numeric_config_columns <- c(
    "sa_hz", "min_f0_hz", "max_f0_hz"
  )
  config[, (numeric_config_columns) := lapply(.SD, as.numeric),
         .SDcols = numeric_config_columns]

  config <- config[as.logical(include)]

  if (nrow(config) == 0L) {
    stop("No recordings are marked for inclusion.", call. = FALSE)
  }

  if (anyDuplicated(config$recording_id)) {
    stop("recording_id values must be unique.", call. = FALSE)
  }

  if (anyDuplicated(config$file_name)) {
    stop("file_name values must be unique.", call. = FALSE)
  }

  if (!(REFERENCE_ID %in% config$recording_id)) {
    stop("REFERENCE_ID is not present in recordings.csv.", call. = FALSE)
  }

  if (any(!is.finite(config$sa_hz) | config$sa_hz <= 0)) {
    bad_ids <- config[!is.finite(sa_hz) | sa_hz <= 0, recording_id]
    stop(
      "Supply a positive sa_hz for: ", paste(bad_ids, collapse = ", "),
      call. = FALSE
    )
  }

  if (any(config$min_f0_hz <= 0 | config$max_f0_hz <= config$min_f0_hz)) {
    stop("Every recording must satisfy 0 < min_f0_hz < max_f0_hz.", call. = FALSE)
  }

  config[, audio_path := file.path(AUDIO_DIR, file_name)]
  missing_audio <- config[!file.exists(audio_path), audio_path]

  if (length(missing_audio) > 0L) {
    stop(
      "The following audio files do not exist:\n",
      paste(missing_audio, collapse = "\n"),
      call. = FALSE
    )
  }

  dir.create(OUTPUT_DIR, recursive = TRUE, showWarnings = FALSE)
  dir.create(file.path(OUTPUT_DIR, "frames"), recursive = TRUE, showWarnings = FALSE)
  dir.create(file.path(OUTPUT_DIR, "events"), recursive = TRUE, showWarnings = FALSE)
  dir.create(file.path(OUTPUT_DIR, "plots"), recursive = TRUE, showWarnings = FALSE)
  dir.create(file.path(OUTPUT_DIR, "transitions"), recursive = TRUE, showWarnings = FALSE)
  dir.create(CACHE_DIR, recursive = TRUE, showWarnings = FALSE)
  dir.create(file.path(CACHE_DIR, "recordings"), recursive = TRUE,
             showWarnings = FALSE)
  dir.create(file.path(CACHE_DIR, "f0"), recursive = TRUE,
             showWarnings = FALSE)
  dir.create(file.path(CACHE_DIR, "logs"), recursive = TRUE,
             showWarnings = FALSE)

  if (!(RUN_STAGE %in% c("both", "process", "summarize"))) {
    stop("RUN_STAGE must be 'both', 'process', or 'summarize'.", call. = FALSE)
  }

  if (!identical(F0_METHOD, "pyin")) {
    stop("This script version requires F0_METHOD <- \"pyin\".", call. = FALSE)
  }

  if (!file.exists(SCRIPT_FILE)) {
    stop(
      "The script must be saved as '", SCRIPT_FILE,
      "' in the project working directory before it is run.",
      call. = FALSE
    )
  }

  SCRIPT_PATH <- normalizePath(SCRIPT_FILE, winslash = "/", mustWork = TRUE)


  # -----------------------------------------------------------------------------
  # 5. KAFI SWARA SYSTEM
  # -----------------------------------------------------------------------------

  make_kafi_swara_table <- function(tuning_system = c("just", "equal")) {
    tuning_system <- match.arg(tuning_system)

    swara <- c("Sa", "Re", "g", "Ma", "Pa", "Dha", "n")
    description <- c(
      "Sa", "shuddha Re", "komal Ga", "shuddha Ma",
      "Pa", "shuddha Dha", "komal Ni"
    )

    if (tuning_system == "just") {
      ratio <- c(1, 9 / 8, 6 / 5, 4 / 3, 3 / 2, 5 / 3, 9 / 5)
      base_cents <- 1200 * log2(ratio)
    } else {
      base_cents <- c(0, 200, 300, 500, 700, 900, 1000)
      ratio <- 2^(base_cents / 1200)
    }

    data.table::data.table(
      swara = swara,
      description = description,
      ratio = ratio,
      base_cents = base_cents,
      swara_order = seq_along(swara)
    )
  }

  swara_table <- make_kafi_swara_table(TUNING_SYSTEM)

  candidate_table <- data.table::rbindlist(
    lapply(OCTAVE_RANGE, function(octave_value) {
      ans <- data.table::copy(swara_table)
      ans[, octave := octave_value]
      ans[, target_cents := base_cents + 1200 * octave]
      ans[, pitch_semitones := target_cents / 100]
      ans[, swara_octave := sprintf("%s[%+d]", swara, octave)]
      ans
    })
  )

  data.table::setorder(candidate_table, target_cents)


  # -----------------------------------------------------------------------------
  # 5A. RESUMABLE CHECKPOINT HELPERS
  # -----------------------------------------------------------------------------

  recording_checkpoint_path <- function(recording_id) {
    file.path(
      CACHE_DIR,
      "recordings",
      paste0(safe_filename(recording_id), "_checkpoint.rds")
    )
  }

  f0_checkpoint_path <- function(recording_id) {
    file.path(
      CACHE_DIR,
      "f0",
      paste0(safe_filename(recording_id), "_pyin_f0.rds")
    )
  }

  make_f0_signature <- function(config_row) {
    audio_information <- file.info(config_row$audio_path)

    list(
      f0_cache_format_version = F0_CACHE_FORMAT_VERSION,
      recording_id = as.character(config_row$recording_id),
      audio_path = normalizePath(
        config_row$audio_path,
        winslash = "/",
        mustWork = TRUE
      ),
      audio_size_bytes = as.numeric(audio_information$size[1]),
      audio_modified_time = as.numeric(audio_information$mtime[1]),
      f0_method = F0_METHOD,
      librosa_requirement = LIBROSA_REQUIREMENT,
      min_f0_hz = as.numeric(config_row$min_f0_hz),
      max_f0_hz = as.numeric(config_row$max_f0_hz),
      window_shift_ms = as.numeric(WINDOW_SHIFT_MS),
      pyin_frame_length = as.integer(PYIN_FRAME_LENGTH),
      pyin_resolution = as.numeric(PYIN_RESOLUTION)
    )
  }

  make_recording_signature <- function(config_row) {
    list(
      cache_format_version = CACHE_FORMAT_VERSION,
      recording_id = as.character(config_row$recording_id),
      f0_signature = make_f0_signature(config_row),
      sa_hz = as.numeric(config_row$sa_hz),
      smoothing_window_ms = as.numeric(SMOOTH_WINDOW_MS),
      minimum_event_sec = as.numeric(MIN_EVENT_SEC),
      maximum_bridged_gap_sec = as.numeric(MAX_BRIDGED_GAP_SEC),
      swara_tolerance_cents = as.numeric(SWARA_TOLERANCE_CENTS),
      octave_range = as.integer(OCTAVE_RANGE),
      tuning_system = TUNING_SYSTEM,
      robust_pitch_lower_probability = as.numeric(ROBUST_PITCH_LOWER_PROB),
      robust_pitch_upper_probability = as.numeric(ROBUST_PITCH_UPPER_PROB),
      robust_transition_upper_probability = as.numeric(
        ROBUST_TRANSITION_UPPER_PROB
      ),
      pitch_jump_warning_semitones = as.numeric(
        PITCH_JUMP_WARNING_SEMITONES
      ),
      pitch_jump_extreme_semitones = as.numeric(
        PITCH_JUMP_EXTREME_SEMITONES
      )
    )
  }

  save_checkpoint_safely <- function(result, path) {
    temporary_path <- paste0(path, ".tmp")
    saveRDS(result, temporary_path, compress = TRUE)

    copied <- file.copy(temporary_path, path, overwrite = TRUE)
    unlink(temporary_path)

    if (!isTRUE(copied) || !file.exists(path)) {
      stop("Could not finalize checkpoint: ", path, call. = FALSE)
    }
  }

  read_valid_f0_checkpoint <- function(config_row) {
    checkpoint_path <- f0_checkpoint_path(config_row$recording_id)

    if (!file.exists(checkpoint_path)) {
      return(list(valid = FALSE, reason = "f0_checkpoint_missing"))
    }

    checkpoint <- tryCatch(readRDS(checkpoint_path), error = function(e) NULL)
    if (is.null(checkpoint) || !is.list(checkpoint)) {
      return(list(valid = FALSE, reason = "f0_checkpoint_unreadable"))
    }

    required_components <- c("signature", "frames", "extractor")
    if (!all(required_components %in% names(checkpoint))) {
      return(list(valid = FALSE, reason = "f0_checkpoint_incomplete"))
    }

    if (!identical(checkpoint$signature, make_f0_signature(config_row))) {
      return(list(valid = FALSE, reason = "audio_or_pyin_settings_changed"))
    }

    required_frame_columns <- c(
      "frame", "time", "f0_hz", "voiced_flag", "voiced_probability",
      "frame_duration"
    )
    if (!all(required_frame_columns %in% names(checkpoint$frames))) {
      return(list(valid = FALSE, reason = "f0_frames_incomplete"))
    }

    rm(checkpoint)
    list(valid = TRUE, reason = "valid")
  }

  run_pyin_extraction <- function(config_row) {
    recording_id <- as.character(config_row$recording_id)
    worker_output <- file.path(
      CACHE_DIR,
      "f0",
      paste0(safe_filename(recording_id), "_worker_output.rds")
    )
    worker_log <- file.path(
      CACHE_DIR,
      "logs",
      paste0(safe_filename(recording_id), "_pyin.log")
    )

    unlink(worker_output)
    on.exit(unlink(worker_output), add = TRUE)

    rscript_binary <- file.path(
      R.home("bin"),
      if (.Platform$OS.type == "windows") "Rscript.exe" else "Rscript"
    )

    worker_arguments <- c(
      shQuote(SCRIPT_PATH),
      "--pyin-worker",
      shQuote(normalizePath(config_row$audio_path, winslash = "/", mustWork = TRUE)),
      shQuote(normalizePath(worker_output, winslash = "/", mustWork = FALSE)),
      as.character(config_row$min_f0_hz),
      as.character(config_row$max_f0_hz),
      as.character(PYIN_FRAME_LENGTH),
      as.character(WINDOW_SHIFT_MS),
      as.character(PYIN_RESOLUTION),
      LIBROSA_REQUIREMENT
    )

    status <- system2(
      command = rscript_binary,
      args = worker_arguments,
      stdout = worker_log,
      stderr = worker_log,
      wait = TRUE
    )

    if (!identical(as.integer(status), 0L) || !file.exists(worker_output)) {
      log_text <- if (file.exists(worker_log)) {
        paste(readLines(worker_log, warn = FALSE), collapse = "\n")
      } else {
        "No worker log was created."
      }
      stop(
        "pYIN extraction failed for ", recording_id, ".\n",
        "See: ", worker_log, "\n", log_text,
        call. = FALSE
      )
    }

    worker_result <- readRDS(worker_output)
    frames <- data.table::as.data.table(worker_result$frames)

    if (nrow(frames) == 0L || !any(is.finite(frames$f0_hz))) {
      stop("pYIN produced no voiced F0 values for ", recording_id,
           call. = FALSE)
    }

    checkpoint <- c(
      list(
        signature = make_f0_signature(config_row),
        frames = frames,
        cached_at = format(Sys.time(), tz = "UTC", usetz = TRUE)
      ),
      worker_result[setdiff(names(worker_result), "frames")]
    )

    save_checkpoint_safely(checkpoint, f0_checkpoint_path(recording_id))
    invisible(f0_checkpoint_path(recording_id))
  }

  load_cached_f0_frames <- function(recording_id) {
    checkpoint <- readRDS(f0_checkpoint_path(recording_id))
    data.table::as.data.table(checkpoint$frames)
  }

  read_valid_checkpoint <- function(config_row) {
    recording_id <- as.character(config_row$recording_id)
    checkpoint_path <- recording_checkpoint_path(recording_id)

    if (!file.exists(checkpoint_path)) {
      return(list(valid = FALSE, reason = "checkpoint_missing", result = NULL))
    }

    checkpoint <- tryCatch(
      readRDS(checkpoint_path),
      error = function(e) NULL
    )

    if (is.null(checkpoint) || !is.list(checkpoint)) {
      return(list(valid = FALSE, reason = "checkpoint_unreadable", result = NULL))
    }

    required_components <- c(
      "signature", "frames", "events", "parameters", "distribution",
      "transitions", "quality"
    )

    if (!all(required_components %in% names(checkpoint))) {
      return(list(valid = FALSE, reason = "checkpoint_incomplete", result = NULL))
    }

    expected_signature <- make_recording_signature(config_row)
    if (!identical(checkpoint$signature, expected_signature)) {
      return(list(valid = FALSE, reason = "settings_or_audio_changed", result = NULL))
    }

    # Return only the validation result. Keeping the checkpoint here would make
    # lapply() retain all recordings in memory during the Stage 2 preflight.
    rm(checkpoint)
    list(valid = TRUE, reason = "valid", result = NULL)
  }

  write_processing_status <- function(status_table) {
    data.table::fwrite(
      status_table,
      file.path(CACHE_DIR, "processing_status.csv")
    )
  }


  # -----------------------------------------------------------------------------
  # 6. F0 SMOOTHING
  # -----------------------------------------------------------------------------

  smooth_voiced_runs <- function(f0, kernel_frames) {
    output <- f0
    voiced <- is.finite(f0) & f0 > 0

    if (!any(voiced)) return(output)

    run_id <- data.table::rleid(voiced)
    groups <- unique(run_id[voiced])

    for (group_value in groups) {
      index <- which(run_id == group_value & voiced)
      n_group <- length(index)

      if (n_group < 3L) next

      k <- min(kernel_frames, n_group)
      if (k %% 2L == 0L) k <- k - 1L
      if (k < 3L) next

      output[index] <- stats::runmed(f0[index], k = k, endrule = "median")
    }

    output
  }


  # -----------------------------------------------------------------------------
  # 7. F0-TO-SWARA MAPPING
  # -----------------------------------------------------------------------------

  map_f0_to_swara <- function(
      f0,
      sa_hz,
      candidates = candidate_table,
      tolerance_cents = SWARA_TOLERANCE_CENTS) {

    n <- length(f0)

    output <- data.table::data.table(
      pitch_cents = rep(NA_real_, n),
      swara = rep(NA_character_, n),
      octave = rep(NA_integer_, n),
      swara_octave = rep(NA_character_, n),
      target_cents = rep(NA_real_, n),
      distance_cents = rep(NA_real_, n),
      mapping_status = rep("unvoiced", n)
    )

    valid_index <- which(is.finite(f0) & f0 > 0)
    if (length(valid_index) == 0L) return(output)

    observed_cents <- 1200 * log2(f0[valid_index] / sa_hz)
    output$pitch_cents[valid_index] <- observed_cents

    for (j in seq_along(valid_index)) {
      row_index <- valid_index[j]
      distances <- abs(observed_cents[j] - candidates$target_cents)
      nearest <- which.min(distances)
      minimum_distance <- distances[nearest]

      output$distance_cents[row_index] <- minimum_distance

      if (minimum_distance <= tolerance_cents) {
        output$swara[row_index] <- candidates$swara[nearest]
        output$octave[row_index] <- candidates$octave[nearest]
        output$swara_octave[row_index] <- candidates$swara_octave[nearest]
        output$target_cents[row_index] <- candidates$target_cents[nearest]
        output$mapping_status[row_index] <- "accepted"
      } else {
        output$mapping_status[row_index] <- "outside_tolerance"
      }
    }

    output
  }


  # -----------------------------------------------------------------------------
  # 8. FRAME-LABEL CLEANING
  # -----------------------------------------------------------------------------

  bridge_short_gaps <- function(labels, max_gap_frames) {
    sentinel <- "__UNVOICED__"
    x <- ifelse(is.na(labels), sentinel, labels)

    if (max_gap_frames <= 0L || length(x) == 0L) {
      x[x == sentinel] <- NA_character_
      return(x)
    }

    repeat {
      runs <- rle(x)
      ends <- cumsum(runs$lengths)
      starts <- ends - runs$lengths + 1L

      candidate_runs <- which(
        runs$values == sentinel &
          runs$lengths <= max_gap_frames &
          seq_along(runs$values) > 1L &
          seq_along(runs$values) < length(runs$values)
      )

      changed <- FALSE

      for (run_number in candidate_runs) {
        left_label <- runs$values[run_number - 1L]
        right_label <- runs$values[run_number + 1L]

        if (left_label == right_label && left_label != sentinel) {
          x[starts[run_number]:ends[run_number]] <- left_label
          changed <- TRUE
        }
      }

      if (!changed) break
    }

    x[x == sentinel] <- NA_character_
    x
  }

  remove_or_merge_short_events <- function(labels, min_event_frames) {
    sentinel <- "__UNVOICED__"
    x <- ifelse(is.na(labels), sentinel, labels)

    if (min_event_frames <= 1L || length(x) == 0L) {
      x[x == sentinel] <- NA_character_
      return(x)
    }

    repeat {
      runs <- rle(x)
      ends <- cumsum(runs$lengths)
      starts <- ends - runs$lengths + 1L

      short_runs <- which(
        runs$values != sentinel & runs$lengths < min_event_frames
      )

      if (length(short_runs) == 0L) break

      changed <- FALSE

      for (run_number in short_runs) {
        replacement <- sentinel

        if (run_number > 1L && run_number < length(runs$values)) {
          left_label <- runs$values[run_number - 1L]
          right_label <- runs$values[run_number + 1L]

          if (left_label == right_label && left_label != sentinel) {
            replacement <- left_label
          }
        }

        x[starts[run_number]:ends[run_number]] <- replacement
        changed <- TRUE
      }

      if (!changed) break
    }

    x[x == sentinel] <- NA_character_
    x
  }


  # -----------------------------------------------------------------------------
  # 9. EVENT CONSTRUCTION
  # -----------------------------------------------------------------------------

  build_note_events <- function(frame_data, candidates = candidate_table) {
    if (nrow(frame_data) == 0L) {
      return(data.table::data.table())
    }

    sentinel <- "__UNVOICED__"
    labels <- ifelse(is.na(frame_data$swara_octave_clean), sentinel,
                     frame_data$swara_octave_clean)
    runs <- rle(labels)
    ends <- cumsum(runs$lengths)
    starts <- ends - runs$lengths + 1L
    voiced_runs <- which(runs$values != sentinel)

    if (length(voiced_runs) == 0L) {
      return(data.table::data.table())
    }

    frame_duration <- stats::median(frame_data$frame_duration)

    events <- data.table::rbindlist(
      lapply(voiced_runs, function(run_number) {
        index <- starts[run_number]:ends[run_number]
        event_label <- runs$values[run_number]
        candidate_row <- candidates[swara_octave == event_label][1]

        median_f0 <- safe_median(frame_data$f0_smoothed_hz[index])
        median_cents <- safe_median(frame_data$pitch_cents[index])

        if (!is.finite(median_cents)) {
          median_cents <- candidate_row$target_cents
        }

        data.table::data.table(
          Note = candidate_row$swara,
          Octave = candidate_row$octave,
          Note_Octave = event_label,
          Start = frame_data$time[index[1]],
          End = frame_data$time[index[length(index)]] + frame_duration,
          Duration = length(index) * frame_duration,
          Frame_Count = length(index),
          Median_F0_Hz = median_f0,
          Median_Pitch_Cents = median_cents,
          Pitch_Semitones = median_cents / 100,
          Target_Cents = candidate_row$target_cents,
          Target_Semitones = candidate_row$target_cents / 100
        )
      }),
      use.names = TRUE
    )

    events[, Event_ID := seq_len(.N)]
    events[, IOI := Start - data.table::shift(Start)]
    data.table::setcolorder(
      events,
      c(
        "Event_ID", "Note", "Octave", "Note_Octave", "Start", "End",
        "Duration", "IOI", "Frame_Count", "Median_F0_Hz",
        "Median_Pitch_Cents", "Pitch_Semitones", "Target_Cents",
        "Target_Semitones"
      )
    )

    events
  }


  # -----------------------------------------------------------------------------
  # 10. RECORDING-LEVEL STATISTICAL SUMMARIES
  # -----------------------------------------------------------------------------

  calculate_parameters <- function(events, recording_id) {
    if (nrow(events) == 0L) {
      stop("No valid note events were obtained for ", recording_id, call. = FALSE)
    }

    pitch <- events$Pitch_Semitones
    duration <- events$Duration
    keep <- is.finite(pitch) & is.finite(duration) & duration > 0
    pitch <- pitch[keep]
    duration <- duration[keep]

    if (length(pitch) == 0L) {
      stop("No valid pitch-duration pairs were obtained for ", recording_id,
           call. = FALSE)
    }

    p1 <- sum(pitch * duration) / sum(duration) - min(pitch)
    p2 <- max(pitch) - min(pitch)

    pitch_quantiles <- weighted_quantile(
      pitch,
      duration,
      c(ROBUST_PITCH_LOWER_PROB, ROBUST_PITCH_UPPER_PROB)
    )
    pitch_q05 <- pitch_quantiles[1]
    pitch_q95 <- pitch_quantiles[2]
    winsorised_pitch <- pmin(pmax(pitch, pitch_q05), pitch_q95)

    p1_robust <- (
      sum(winsorised_pitch * duration) / sum(duration)
    ) - pitch_q05
    p2_robust <- pitch_q95 - pitch_q05

    pitch_transitions <- if (length(pitch) >= 2L) {
      abs(diff(pitch))
    } else {
      numeric()
    }

    p3 <- if (length(pitch_transitions) > 0L) {
      mean(pitch_transitions)
    } else {
      NA_real_
    }
    p3_median <- if (length(pitch_transitions) > 0L) {
      stats::median(pitch_transitions)
    } else {
      NA_real_
    }
    # Retain exactly the smallest ceiling(90% * n) transitions. Selecting by
    # rank rather than by a quantile cutoff prevents tied, quantised pYIN values
    # from accidentally retaining substantially more than 90% of transitions.
    retained_transition_count <- if (length(pitch_transitions) > 0L) {
      max(1L, as.integer(ceiling(
        ROBUST_TRANSITION_UPPER_PROB * length(pitch_transitions)
      )))
    } else {
      0L
    }
    p3_robust <- if (retained_transition_count > 0L) {
      mean(sort(pitch_transitions)[seq_len(retained_transition_count)])
    } else {
      NA_real_
    }

    n_pitch_jumps_ge_7 <- sum(
      pitch_transitions >= PITCH_JUMP_WARNING_SEMITONES
    )
    n_pitch_jumps_ge_10 <- sum(
      pitch_transitions >= PITCH_JUMP_EXTREME_SEMITONES
    )
    p4 <- max(duration)
    p5 <- mean(duration)

    data.table::data.table(
      recording_id = recording_id,
      n_events = length(pitch),
      P1_weighted_pitch_centre = p1,
      P2_melodic_span = p2,
      P3_mean_pitch_transition = p3,
      Pitch_Q05 = pitch_q05,
      Pitch_Q95 = pitch_q95,
      P1_robust_winsorised_pitch_centre = p1_robust,
      P2_robust_quantile_span = p2_robust,
      P3_robust_trimmed_mean_transition = p3_robust,
      P3_median_pitch_transition = p3_median,
      N_pitch_jumps_ge_7 = n_pitch_jumps_ge_7,
      N_pitch_jumps_ge_10 = n_pitch_jumps_ge_10,
      P4_max_note_duration = p4,
      P5_mean_note_duration = p5
    )
  }

  calculate_swara_distribution <- function(events, recording_id) {
    observed <- events[, .(
      Count = .N,
      Total_Duration = sum(Duration)
    ), by = Note]

    complete <- merge(
      swara_table[, .(Note = swara, Swara_Order = swara_order)],
      observed,
      by = "Note",
      all.x = TRUE,
      sort = FALSE
    )

    complete[is.na(Count), Count := 0L]
    complete[is.na(Total_Duration), Total_Duration := 0]
    data.table::setorder(complete, Swara_Order)

    complete[, Count_Probability := normalise_probability(Count)]
    complete[, Duration_Probability := normalise_probability(Total_Duration)]
    complete[, recording_id := recording_id]

    data.table::setcolorder(
      complete,
      c(
        "recording_id", "Note", "Swara_Order", "Count", "Total_Duration",
        "Count_Probability", "Duration_Probability"
      )
    )

    complete
  }

  calculate_transition_table <- function(events, recording_id) {
    if (nrow(events) < 2L) {
      return(data.table::data.table(
        recording_id = character(), From = character(), To = character(),
        Count = integer(), Probability = numeric()
      ))
    }

    transitions <- data.table::data.table(
      From = events$Note[-nrow(events)],
      To = events$Note[-1L]
    )

    transitions <- transitions[, .(Count = .N), by = .(From, To)]
    transitions[, Probability := Count / sum(Count), by = From]
    transitions[, recording_id := recording_id]
    data.table::setcolorder(
      transitions,
      c("recording_id", "From", "To", "Count", "Probability")
    )
    transitions
  }


