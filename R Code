  # -----------------------------------------------------------------------------
  # 12. COMPLETE PROCESSING OF ONE RECORDING
  # -----------------------------------------------------------------------------

  process_recording <- function(config_row, raw_f0_frames) {
    recording_id <- as.character(config_row$recording_id)

    message("Mapping cached pYIN F0 for ", recording_id, " ...")
    frames <- data.table::copy(data.table::as.data.table(raw_f0_frames))

    frame_duration <- stats::median(frames$frame_duration)
    smoothing_frames <- make_odd((SMOOTH_WINDOW_MS / 1000) / frame_duration)
    gap_frames <- as.integer(floor(MAX_BRIDGED_GAP_SEC / frame_duration))
    minimum_event_frames <- as.integer(ceiling(MIN_EVENT_SEC / frame_duration))

    frames[, f0_smoothed_hz := smooth_voiced_runs(f0_hz, smoothing_frames)]

    mapped <- map_f0_to_swara(
      f0 = frames$f0_smoothed_hz,
      sa_hz = config_row$sa_hz
    )

    frames <- cbind(frames, mapped)

    cleaned_labels <- bridge_short_gaps(
      frames$swara_octave,
      max_gap_frames = gap_frames
    )

    cleaned_labels <- remove_or_merge_short_events(
      cleaned_labels,
      min_event_frames = minimum_event_frames
    )

    frames[, swara_octave_clean := cleaned_labels]
    events <- build_note_events(frames)

    if (nrow(events) == 0L) {
      stop("No valid events remained after cleaning for ", recording_id,
           call. = FALSE)
    }

    parameters <- calculate_parameters(events, recording_id)
    distribution <- calculate_swara_distribution(events, recording_id)
    transitions <- calculate_transition_table(events, recording_id)

    total_frames <- nrow(frames)
    raw_voiced <- sum(is.finite(frames$f0_hz))
    mapped_frames <- sum(frames$mapping_status == "accepted")
    final_labelled_frames <- sum(!is.na(frames$swara_octave_clean))

    quality <- data.table::data.table(
      recording_id = recording_id,
      file_name = as.character(config_row$file_name),
      sa_hz = as.numeric(config_row$sa_hz),
      total_frames = total_frames,
      raw_voiced_frames = raw_voiced,
      accepted_mapping_frames = mapped_frames,
      final_labelled_frames = final_labelled_frames,
      raw_voiced_fraction = raw_voiced / total_frames,
      mean_voiced_probability = safe_mean(frames$voiced_probability),
      median_voiced_probability = safe_median(frames$voiced_probability),
      accepted_mapping_fraction = mapped_frames / total_frames,
      final_labelled_fraction = final_labelled_frames / total_frames,
      n_final_events = nrow(events),
      frame_duration_sec = frame_duration,
      smoothing_frames = smoothing_frames,
      minimum_event_frames = minimum_event_frames,
      bridged_gap_frames = gap_frames
    )

    list(
      frames = frames,
      events = events,
      parameters = parameters,
      distribution = distribution,
      transitions = transitions,
      quality = quality
    )
  }


  # -----------------------------------------------------------------------------
  # 13. STAGE 1: PROCESS AND CACHE EACH RECORDING INDEPENDENTLY
  # -----------------------------------------------------------------------------

  processing_status <- data.table::data.table(
    recording_id = config$recording_id,
    status = "pending",
    message = NA_character_,
    f0_checkpoint = vapply(
      config$recording_id,
      f0_checkpoint_path,
      character(1)
    ),
    checkpoint = vapply(
      config$recording_id,
      recording_checkpoint_path,
      character(1)
    )
  )

  if (RUN_STAGE %in% c("both", "process")) {
    for (i in seq_len(nrow(config))) {
      current_row <- config[i]
      current_id <- as.character(current_row$recording_id)
      force_f0 <- isTRUE(FORCE_F0_REEXTRACTION) ||
        current_id %in% REEXTRACT_F0_IDS
      force_current <- isTRUE(FORCE_REPROCESS) ||
        current_id %in% REPROCESS_IDS || force_f0

      f0_check <- read_valid_f0_checkpoint(current_row)

      if (!f0_check$valid || force_f0) {
        processing_status[recording_id == current_id, `:=`(
          status = "extracting_pyin",
          message = if (force_f0) {
            "Forced raw pYIN re-extraction requested."
          } else {
            paste("Raw pYIN checkpoint unavailable:", f0_check$reason)
          }
        )]
        write_processing_status(processing_status)
        writeLines(
          paste(format(Sys.time()), "Extracting pYIN F0", current_id),
          file.path(CACHE_DIR, "current_recording.txt")
        )

        f0_success <- tryCatch(
          {
            run_pyin_extraction(current_row)
            TRUE
          },
          error = function(e) {
            processing_status[recording_id == current_id, `:=`(
              status = "failed",
              message = conditionMessage(e)
            )]
            write_processing_status(processing_status)
            FALSE
          }
        )

        if (!f0_success) {
          rm(f0_check)
          gc(full = TRUE)
          next
        }
      } else {
        message("Using cached pYIN F0 for ", current_id, " ...")
      }

      rm(f0_check)
      gc(full = TRUE)

      checkpoint_check <- read_valid_checkpoint(current_row)

      if (checkpoint_check$valid && !force_current) {
        message("Using cached result for ", current_id, " ...")
        processing_status[recording_id == current_id, `:=`(
          status = "cached",
          message = "Raw pYIN and analysis checkpoints reused."
        )]
        write_processing_status(processing_status)
        rm(checkpoint_check)
        gc(full = TRUE)
        next
      }

      processing_status[recording_id == current_id, `:=`(
        status = "processing",
        message = if (force_current) {
          "Rebuilding tonic-dependent analysis from cached pYIN F0."
        } else {
          paste("Analysis checkpoint unavailable:", checkpoint_check$reason)
        }
      )]
      write_processing_status(processing_status)
      writeLines(
        paste(format(Sys.time()), "Processing", current_id),
        file.path(CACHE_DIR, "current_recording.txt")
      )

      rm(checkpoint_check)
      gc(full = TRUE)

      raw_f0_frames <- tryCatch(
        load_cached_f0_frames(current_id),
        error = function(e) NULL
      )

      result <- tryCatch(
        {
          if (is.null(raw_f0_frames)) {
            stop("The raw pYIN checkpoint could not be loaded.", call. = FALSE)
          }
          process_recording(current_row, raw_f0_frames)
        },
        error = function(e) {
          processing_status[recording_id == current_id, `:=`(
            status = "failed",
            message = conditionMessage(e)
          )]
          write_processing_status(processing_status)
          NULL
        }
      )

      if (is.null(result)) {
        rm(raw_f0_frames)
        gc(full = TRUE)
        next
      }

      result$signature <- make_recording_signature(current_row)
      result$cached_at <- format(Sys.time(), tz = "UTC", usetz = TRUE)

      save_checkpoint_safely(
        result,
        recording_checkpoint_path(current_id)
      )

      processing_status[recording_id == current_id, `:=`(
        status = "processed",
        message = "Tonic-dependent analysis checkpoint created successfully."
      )]
      write_processing_status(processing_status)
      writeLines(
        paste(format(Sys.time()), "Completed", current_id),
        file.path(CACHE_DIR, "current_recording.txt")
      )

      rm(result, raw_f0_frames)
      gc(full = TRUE)
    }

    failed_ids <- processing_status[status == "failed", recording_id]
    if (length(failed_ids) > 0L) {
      stop(
        "Stage 1 failed for: ", paste(failed_ids, collapse = ", "),
        ". Successful checkpoints were preserved. Correct the failed recording ",
        "and run the script again; completed recordings will be skipped.",
        call. = FALSE
      )
    }
  }

  if (RUN_STAGE == "process") {
    message(
      "Stage 1 completed. Checkpoints are available in: ",
      normalizePath(CACHE_DIR),
      "\nUse mode \"summarize\" to build the final outputs without F0 extraction."
    )
  }


  # -----------------------------------------------------------------------------
  # 14. STAGE 2: REBUILD OUTPUTS FROM VALID CHECKPOINTS
  # -----------------------------------------------------------------------------

  if (RUN_STAGE %in% c("both", "summarize")) {
    checkpoint_checks <- lapply(
      seq_len(nrow(config)),
      function(i) read_valid_checkpoint(config[i])
    )

    checkpoint_valid <- vapply(checkpoint_checks, `[[`, logical(1), "valid")

    if (!all(checkpoint_valid)) {
      invalid_ids <- config$recording_id[!checkpoint_valid]
      invalid_reasons <- vapply(
        checkpoint_checks[!checkpoint_valid],
        `[[`,
        character(1),
        "reason"
      )

      invalid_description <- paste0(
        invalid_ids,
        " (",
        invalid_reasons,
        ")",
        collapse = ", "
      )

      stop(
        "Stage 2 cannot begin because these checkpoints are missing or stale: ",
        invalid_description,
        ". Use mode \"analysis\" and rerun the script.",
        call. = FALSE
      )
    }

    rm(checkpoint_checks)
    gc(full = TRUE)

    event_list <- vector("list", nrow(config))
    parameter_list <- vector("list", nrow(config))
    distribution_list <- vector("list", nrow(config))
    transition_list <- vector("list", nrow(config))
    quality_list <- vector("list", nrow(config))

    for (i in seq_len(nrow(config))) {
      current_id <- as.character(config$recording_id[i])
      file_id <- safe_filename(current_id)
      message("Building outputs from cache for ", current_id, " ...")

      checkpoint <- readRDS(recording_checkpoint_path(current_id))

      data.table::fwrite(
        checkpoint$frames,
        file.path(OUTPUT_DIR, "frames", paste0(file_id, "_frames.csv"))
      )
      data.table::fwrite(
        checkpoint$events,
        file.path(OUTPUT_DIR, "events", paste0(file_id, "_events.csv"))
      )
      data.table::fwrite(
        checkpoint$transitions,
        file.path(OUTPUT_DIR, "transitions", paste0(file_id, "_transitions.csv"))
      )

      save_progression_plot(
        checkpoint$events,
        current_id,
        file.path(OUTPUT_DIR, "plots", paste0(file_id, "_progression.png"))
      )
      save_frequency_plot(
        checkpoint$distribution,
        current_id,
        file.path(OUTPUT_DIR, "plots", paste0(file_id, "_frequency.png"))
      )
      save_pyin_plot(
        checkpoint$frames,
        current_id,
        file.path(OUTPUT_DIR, "plots", paste0(file_id, "_pyin_f0.png"))
      )

      events_with_id <- data.table::copy(checkpoint$events)
      events_with_id[, recording_id := current_id]
      data.table::setcolorder(
        events_with_id,
        c("recording_id", setdiff(names(events_with_id), "recording_id"))
      )

      event_list[[i]] <- events_with_id
      parameter_list[[i]] <- checkpoint$parameters
      distribution_list[[i]] <- checkpoint$distribution
      transition_list[[i]] <- checkpoint$transitions
      quality_list[[i]] <- checkpoint$quality

      rm(checkpoint, events_with_id)
      gc(full = TRUE)
    }

    all_events <- data.table::rbindlist(event_list, use.names = TRUE, fill = TRUE)
    all_parameters <- data.table::rbindlist(parameter_list, use.names = TRUE)
    all_distributions <- data.table::rbindlist(distribution_list, use.names = TRUE)
    all_transitions <- data.table::rbindlist(
      transition_list,
      use.names = TRUE,
      fill = TRUE
    )
    quality_summary <- data.table::rbindlist(quality_list, use.names = TRUE)

    rm(event_list, parameter_list, distribution_list, transition_list, quality_list)
    gc(full = TRUE)

    data.table::fwrite(all_events, file.path(OUTPUT_DIR, "all_note_events.csv"))
    data.table::fwrite(all_parameters, file.path(OUTPUT_DIR, "P1_to_P5.csv"))
    data.table::fwrite(
      all_distributions,
      file.path(OUTPUT_DIR, "swara_distributions.csv")
    )
    data.table::fwrite(
      all_transitions,
      file.path(OUTPUT_DIR, "all_transitions.csv")
    )
    data.table::fwrite(
      quality_summary,
      file.path(OUTPUT_DIR, "quality_summary.csv")
    )

    if (file.exists(file.path(CACHE_DIR, "processing_status.csv"))) {
      file.copy(
        file.path(CACHE_DIR, "processing_status.csv"),
        file.path(OUTPUT_DIR, "processing_log.csv"),
        overwrite = TRUE
      )
    }


    # ---------------------------------------------------------------------------
    # 15. BHATTACHARYYA DISTANCES
    # ---------------------------------------------------------------------------

    bhattacharyya_distance <- function(p, q) {
      p <- normalise_probability(p)
      q <- normalise_probability(q)

      if (anyNA(p) || anyNA(q)) return(NA_real_)

      coefficient <- sum(sqrt(p * q))
      coefficient <- min(max(coefficient, 0), 1)

      if (coefficient <= 0) return(Inf)
      -log(coefficient)
    }

    reference_distribution <- all_distributions[recording_id == REFERENCE_ID]
    data.table::setorder(reference_distribution, Swara_Order)

    comparison_ids <- setdiff(config$recording_id, REFERENCE_ID)
    if (length(comparison_ids) == 0L) {
      # A reference-only run is a valid pYIN smoke test. Preserve the final CSV
      # schema even though no Bhattacharyya comparison can yet be calculated.
      distance_results <- data.table::data.table(
        reference_id = character(),
        recording_id = character(),
        BD_count = numeric(),
        BD_duration = numeric()
      )
    } else {
      distance_results <- data.table::rbindlist(
        lapply(comparison_ids, function(current_id) {
          current_distribution <- all_distributions[recording_id == current_id]
          data.table::setorder(current_distribution, Swara_Order)

          data.table::data.table(
            reference_id = REFERENCE_ID,
            recording_id = current_id,
            BD_count = bhattacharyya_distance(
              reference_distribution$Count_Probability,
              current_distribution$Count_Probability
            ),
            BD_duration = bhattacharyya_distance(
              reference_distribution$Duration_Probability,
              current_distribution$Duration_Probability
            )
          )
        })
      )
    }

    if (PRIMARY_DISTRIBUTION == "count") {
      distance_results[, Primary_BD := BD_count]
    } else if (PRIMARY_DISTRIBUTION == "duration") {
      distance_results[, Primary_BD := BD_duration]
    } else {
      stop("PRIMARY_DISTRIBUTION must be 'count' or 'duration'.", call. = FALSE)
    }

    distance_results[, Rank := data.table::frank(Primary_BD, ties.method = "min")]
    data.table::setorder(distance_results, Rank, recording_id)
    data.table::fwrite(
      distance_results,
      file.path(OUTPUT_DIR, "bhattacharyya_distances.csv")
    )


    # ---------------------------------------------------------------------------
    # 16. DESCRIPTIVE STATISTICS, CONFIDENCE INTERVALS AND SHAPIRO-WILK TESTS
    # ---------------------------------------------------------------------------

    parameter_columns <- c(
      "P1_weighted_pitch_centre",
      "P2_melodic_span",
      "P3_mean_pitch_transition",
      "P1_robust_winsorised_pitch_centre",
      "P2_robust_quantile_span",
      "P3_robust_trimmed_mean_transition",
      "P3_median_pitch_transition",
      "P4_max_note_duration",
      "P5_mean_note_duration"
    )

    parameter_long <- data.table::melt(
      all_parameters[recording_id != REFERENCE_ID],
      id.vars = c("recording_id", "n_events"),
      measure.vars = parameter_columns,
      variable.name = "Parameter",
      value.name = "Value"
    )

    if (nrow(parameter_long) == 0L) {
      # Group summaries intentionally exclude the fixed reference. Therefore a
      # reference-only smoke test has no inferential sample yet.
      descriptive_statistics <- data.table::data.table(
        Parameter = character(), N = integer(), Mean = numeric(),
        SD = numeric(), Median = numeric(), IQR = numeric(),
        Minimum = numeric(), Maximum = numeric(), CV_Percent = numeric(),
        SE = numeric(), CI95_Lower = numeric(), CI95_Upper = numeric()
      )
      shapiro_results <- data.table::data.table(
        Parameter = character(), N = integer(), W = numeric(),
        P_Value = numeric()
      )
    } else {
      descriptive_statistics <- parameter_long[, {
        x <- Value[is.finite(Value)]
        n <- length(x)
        x_mean <- mean(x)
        x_sd <- if (n >= 2L) stats::sd(x) else NA_real_
        standard_error <- if (n >= 2L) x_sd / sqrt(n) else NA_real_
        critical_value <- if (n >= 2L) {
          stats::qt(0.975, df = n - 1L)
        } else {
          NA_real_
        }

        list(
          N = n,
          Mean = x_mean,
          SD = x_sd,
          Median = stats::median(x),
          IQR = stats::IQR(x),
          Minimum = min(x),
          Maximum = max(x),
          CV_Percent = if (x_mean != 0) 100 * x_sd / abs(x_mean) else NA_real_,
          SE = standard_error,
          CI95_Lower = x_mean - critical_value * standard_error,
          CI95_Upper = x_mean + critical_value * standard_error
        )
      }, by = Parameter]

      shapiro_results <- parameter_long[, {
        x <- Value[is.finite(Value)]

        if (length(x) >= 3L && length(x) <= 5000L && stats::sd(x) > 0) {
          test <- stats::shapiro.test(x)
          list(N = length(x), W = unname(test$statistic), P_Value = test$p.value)
        } else {
          list(N = length(x), W = NA_real_, P_Value = NA_real_)
        }
      }, by = Parameter]
    }

    data.table::fwrite(
      descriptive_statistics,
      file.path(OUTPUT_DIR, "descriptive_statistics.csv")
    )
    data.table::fwrite(
      shapiro_results,
      file.path(OUTPUT_DIR, "shapiro_wilk_results.csv")
    )


    # ---------------------------------------------------------------------------
    # 17. SAVE ANALYSIS SETTINGS AND SESSION INFORMATION
    # ---------------------------------------------------------------------------

    analysis_settings <- data.table::data.table(
      Setting = c(
        "Reference ID",
        "Number of included recordings",
        "F0 extractor",
        "Python dependency",
        "pYIN frame length (samples)",
        "pYIN pitch resolution",
        "Window shift (ms)",
        "Smoothing window (ms)",
        "Minimum event duration (s)",
        "Maximum bridged gap (s)",
        "Swara tolerance (cents)",
        "Robust pitch lower quantile",
        "Robust pitch upper quantile",
        "Robust transition retained quantile",
        "Pitch-jump warning threshold (semitones)",
        "Pitch-jump extreme threshold (semitones)",
        "Tuning system",
        "Octave range",
        "Primary Bhattacharyya distribution",
        "Cache format version",
        "Run stage"
      ),
      Value = c(
        REFERENCE_ID,
        as.character(nrow(config)),
        F0_METHOD,
        LIBROSA_REQUIREMENT,
        as.character(PYIN_FRAME_LENGTH),
        as.character(PYIN_RESOLUTION),
        as.character(WINDOW_SHIFT_MS),
        as.character(SMOOTH_WINDOW_MS),
        as.character(MIN_EVENT_SEC),
        as.character(MAX_BRIDGED_GAP_SEC),
        as.character(SWARA_TOLERANCE_CENTS),
        as.character(ROBUST_PITCH_LOWER_PROB),
        as.character(ROBUST_PITCH_UPPER_PROB),
        as.character(ROBUST_TRANSITION_UPPER_PROB),
        as.character(PITCH_JUMP_WARNING_SEMITONES),
        as.character(PITCH_JUMP_EXTREME_SEMITONES),
        TUNING_SYSTEM,
        paste(range(OCTAVE_RANGE), collapse = " to "),
        PRIMARY_DISTRIBUTION,
        CACHE_FORMAT_VERSION,
        RUN_STAGE
      )
    )

    data.table::fwrite(
      analysis_settings,
      file.path(OUTPUT_DIR, "analysis_settings.csv")
    )
    writeLines(
      capture.output(sessionInfo()),
      file.path(OUTPUT_DIR, "R_session_info.txt")
    )

    message(
      "Stage 2 completed successfully for ", nrow(config), " recordings.\n",
      "Results are available in: ", normalizePath(OUTPUT_DIR), "\n",
      "Reusable checkpoints are available in: ", normalizePath(CACHE_DIR)
    )
  }

  invisible(NULL)
}

# =============================================================================
# 4. Transition matrices and heat maps
# =============================================================================

run_transition_analysis <- function(settings) {
  list2env(settings$TRANSITIONS, envir = environment())
  REFERENCE_ID <- settings$REFERENCE_ID
  SWARA_ORDER <- c("Sa", "Re", "g", "Ma", "Pa", "Dha", "n")
  INPUT_CANDIDATES <- c(
    file.path(settings$OUTPUT_DIR, "all_transitions.csv"),
    "all_transitions.csv"
  )
  OUTPUT_DIR <- file.path(settings$OUTPUT_DIR, "transition_summary")

  # -----------------------------------------------------------------------------
  # 2. PACKAGE AND INPUT CHECKS
  # -----------------------------------------------------------------------------

  required_packages <- c("data.table", "ggplot2")
  missing_packages <- required_packages[
    !vapply(required_packages, requireNamespace, logical(1), quietly = TRUE)
  ]

  if (length(missing_packages) > 0L) {
    stop(
      "Install the following packages before running this script: ",
      paste(missing_packages, collapse = ", "),
      "\nRun: install.packages(c(",
      paste(sprintf("\"%s\"", missing_packages), collapse = ", "),
      "))",
      call. = FALSE
    )
  }

  existing_inputs <- INPUT_CANDIDATES[file.exists(INPUT_CANDIDATES)]

  if (length(existing_inputs) == 0L) {
    stop(
      "Could not find all_transitions.csv. Place it either in the project ",
      "directory or in the output directory.",
      call. = FALSE
    )
  }

  INPUT_FILE <- existing_inputs[1L]
  dir.create(OUTPUT_DIR, recursive = TRUE, showWarnings = FALSE)

  message("Reading transition data from: ", normalizePath(INPUT_FILE))


  # -----------------------------------------------------------------------------
  # 3. READ AND VALIDATE THE OBSERVED TRANSITIONS
  # -----------------------------------------------------------------------------

  transitions_raw <- data.table::fread(INPUT_FILE)

  required_columns <- c("recording_id", "From", "To", "Count")
  missing_columns <- setdiff(required_columns, names(transitions_raw))

  if (length(missing_columns) > 0L) {
    stop(
      "The transition file is missing: ",
      paste(missing_columns, collapse = ", "),
      call. = FALSE
    )
  }

  transitions_raw[, recording_id := as.character(recording_id)]
  transitions_raw[, From := as.character(From)]
  transitions_raw[, To := as.character(To)]
  transitions_raw[, Count := as.numeric(Count)]

  if (anyNA(transitions_raw[, .(recording_id, From, To, Count)])) {
    stop("The required transition columns contain missing values.", call. = FALSE)
  }

  if (any(!is.finite(transitions_raw$Count) | transitions_raw$Count < 0)) {
    stop("Transition counts must be finite and non-negative.", call. = FALSE)
  }

  unexpected_swaras <- setdiff(
    union(unique(transitions_raw$From), unique(transitions_raw$To)),
    SWARA_ORDER
  )

  if (length(unexpected_swaras) > 0L) {
    stop(
      "Unexpected swara labels were found: ",
      paste(unexpected_swaras, collapse = ", "),
      call. = FALSE
    )
  }

  recording_ids <- unique(transitions_raw$recording_id)

  if (!(REFERENCE_ID %in% recording_ids)) {
    stop("Reference recording R is not present in the transition file.",
         call. = FALSE)
  }

  participant_ids <- setdiff(recording_ids, REFERENCE_ID)
  if (length(participant_ids) == 0L) {
    message("No participant transitions are available; comparison heat map skipped.")
    return(invisible(NULL))
  }

  if (length(participant_ids) != EXPECTED_PARTICIPANTS) {
    warning(
      "Expected ", EXPECTED_PARTICIPANTS, " participant recordings, but found ",
      length(participant_ids), ". The available participant recordings will be used."
    )
  }


  # -----------------------------------------------------------------------------
  # 4. COMPLETE EVERY RECORDING TO A 7 x 7 MATRIX
  # -----------------------------------------------------------------------------

  # Aggregate defensively in case a From--To pair appears more than once.
  transition_counts <- transitions_raw[, .(
    Count = sum(Count)
  ), by = .(recording_id, From, To)]

  complete_grid <- data.table::CJ(
    recording_id = recording_ids,
    From = SWARA_ORDER,
    To = SWARA_ORDER,
    unique = TRUE
  )

  complete_transitions <- merge(
    complete_grid,
    transition_counts,
    by = c("recording_id", "From", "To"),
    all.x = TRUE,
    sort = FALSE
  )

  complete_transitions[is.na(Count), Count := 0]
  complete_transitions[, Row_Total := sum(Count),
                       by = .(recording_id, From)]
  complete_transitions[, Probability := data.table::fifelse(
    Row_Total > 0,
    Count / Row_Total,
    NA_real_
  )]

  complete_transitions[, From_Order := match(From, SWARA_ORDER)]
  complete_transitions[, To_Order := match(To, SWARA_ORDER)]
  data.table::setorder(
    complete_transitions,
    recording_id,
    From_Order,
    To_Order
  )

  # Numerical validation: every estimable row must sum to one.
  row_checks <- complete_transitions[Row_Total > 0, .(
    Probability_Sum = sum(Probability)
  ), by = .(recording_id, From)]

  bad_rows <- row_checks[abs(Probability_Sum - 1) > 1e-10]

  if (nrow(bad_rows) > 0L) {
    stop("At least one transition-probability row does not sum to one.",
         call. = FALSE)
  }


  # -----------------------------------------------------------------------------
  # 5. REFERENCE AND EQUAL-RECORDING-WEIGHT PARTICIPANT MATRICES
  # -----------------------------------------------------------------------------

  reference_matrix <- data.table::copy(
    complete_transitions[recording_id == REFERENCE_ID]
  )

  # For each originating swara, average only across participant recordings in
  # which that swara has at least one outgoing transition. Because an absent row
  # is NA for all seven destination cells, every retained recording contributes
  # one complete conditional-probability row with equal weight.
  participant_mean_matrix <- complete_transitions[
    recording_id %in% participant_ids,
    .(
      Mean_Probability = if (all(is.na(Probability))) {
        NA_real_
      } else {
        mean(Probability, na.rm = TRUE)
      },
      Median_Probability = if (all(is.na(Probability))) {
        NA_real_
      } else {
        stats::median(Probability, na.rm = TRUE)
      },
      Total_Count = sum(Count),
      N_Recordings_With_Origin = sum(Row_Total > 0),
      N_Recordings_With_Transition = sum(Count > 0)
    ),
    by = .(From, To)
  ]

  participant_mean_matrix[, Transition_Prevalence := data.table::fifelse(
    N_Recordings_With_Origin > 0,
    N_Recordings_With_Transition / N_Recordings_With_Origin,
    NA_real_
  )]
  participant_mean_matrix[, From_Order := match(From, SWARA_ORDER)]
  participant_mean_matrix[, To_Order := match(To, SWARA_ORDER)]
  data.table::setorder(participant_mean_matrix, From_Order, To_Order)

  participant_row_checks <- participant_mean_matrix[
    !is.na(Mean_Probability),
    .(Probability_Sum = sum(Mean_Probability)),
    by = From
  ]

  if (any(abs(participant_row_checks$Probability_Sum - 1) > 1e-10)) {
    stop("At least one mean participant transition row does not sum to one.",
         call. = FALSE)
  }


  # -----------------------------------------------------------------------------
  # 6. DOMINANT-TRANSITION TABLES
  # -----------------------------------------------------------------------------

  reference_dominant <- data.table::copy(reference_matrix[Count > 0])
  data.table::setorder(reference_dominant, -Count, -Probability, From_Order,
                       To_Order)
  reference_dominant <- head(reference_dominant, TOP_N_TRANSITIONS)
  reference_dominant[, Rank := seq_len(.N)]
  reference_dominant <- reference_dominant[, .(
    Rank, From, To, Count, Row_Total, Probability
  )]

  participant_dominant <- data.table::copy(
    participant_mean_matrix[N_Recordings_With_Transition > 0]
  )
  data.table::setorder(
    participant_dominant,
    -Mean_Probability,
    -Transition_Prevalence,
    -Total_Count,
    From_Order,
    To_Order
  )
  participant_dominant <- head(participant_dominant, TOP_N_TRANSITIONS)
  participant_dominant[, Rank := seq_len(.N)]
  participant_dominant <- participant_dominant[, .(
    Rank,
    From,
    To,
    Mean_Probability,
    Median_Probability,
    Total_Count,
    N_Recordings_With_Origin,
    N_Recordings_With_Transition,
    Transition_Prevalence
  )]


  # -----------------------------------------------------------------------------
  # 7. WRITE NUMERICAL OUTPUTS
  # -----------------------------------------------------------------------------

  data.table::fwrite(
    complete_transitions[, .(
      recording_id, From, To, Count, Row_Total, Probability
    )],
    file.path(OUTPUT_DIR, "all_transition_matrices_complete.csv")
  )

  reference_wide <- data.table::dcast(
    reference_matrix,
    From ~ To,
    value.var = "Probability"
  )
  data.table::setcolorder(reference_wide, c("From", SWARA_ORDER))
  reference_wide[, From_Order := match(From, SWARA_ORDER)]
  data.table::setorder(reference_wide, From_Order)
  reference_wide[, From_Order := NULL]

  participant_wide <- data.table::dcast(
    participant_mean_matrix,
    From ~ To,
    value.var = "Mean_Probability"
  )
  data.table::setcolorder(participant_wide, c("From", SWARA_ORDER))
  participant_wide[, From_Order := match(From, SWARA_ORDER)]
  data.table::setorder(participant_wide, From_Order)
  participant_wide[, From_Order := NULL]

  data.table::fwrite(
    reference_wide,
    file.path(OUTPUT_DIR, "reference_transition_matrix.csv")
  )

  data.table::fwrite(
    participant_wide,
    file.path(OUTPUT_DIR, "participant_mean_transition_matrix.csv")
  )

  data.table::fwrite(
    reference_dominant,
    file.path(OUTPUT_DIR, "dominant_transitions_reference.csv")
  )

  data.table::fwrite(
    participant_dominant,
    file.path(OUTPUT_DIR, "dominant_transitions_participants.csv")
  )


  # -----------------------------------------------------------------------------
  # 8. TWO-PANEL PUBLICATION HEATMAP
  # -----------------------------------------------------------------------------

  reference_panel <- paste("(a) Reference", REFERENCE_ID)
  participant_panel <- paste0("(b) Mean of ", length(participant_ids), " participants")

  plot_reference <- reference_matrix[, .(
    Panel = reference_panel,
    From,
    To,
    Probability
  )]

  plot_participants <- participant_mean_matrix[, .(
    Panel = participant_panel,
    From,
    To,
    Probability = Mean_Probability
  )]

  plot_data <- data.table::rbindlist(
    list(plot_reference, plot_participants),
    use.names = TRUE
  )

  plot_data[, Panel := factor(
    Panel,
    levels = c(reference_panel, participant_panel)
  )]
  plot_data[, To := factor(To, levels = SWARA_ORDER)]
  plot_data[, From := factor(From, levels = rev(SWARA_ORDER))]
  plot_data[, Label := ifelse(
    is.na(Probability),
    "--",
    sprintf("%.2f", Probability)
  )]
  plot_data[, Label_Colour := ifelse(
    !is.na(Probability) & Probability >= 0.50,
    "white",
    "#17202A"
  )]

  transition_plot <- ggplot2::ggplot(
    plot_data,
    ggplot2::aes(x = To, y = From, fill = Probability)
  ) +
    ggplot2::geom_tile(colour = "white", linewidth = 0.65) +
    ggplot2::geom_text(
      ggplot2::aes(label = Label, colour = Label_Colour),
      size = 3.5,
      fontface = "bold",
      show.legend = FALSE
    ) +
    ggplot2::scale_colour_identity() +
    ggplot2::scale_fill_gradientn(
      colours = c("#F7FBFF", "#C6DBEF", "#6BAED6", "#2171B5", "#08306B"),
      limits = c(0, 1),
      breaks = seq(0, 1, by = 0.2),
      na.value = "#EEEEEE",
      name = "Conditional\nprobability"
    ) +
    ggplot2::scale_x_discrete(drop = FALSE) +
    ggplot2::scale_y_discrete(drop = FALSE) +
    ggplot2::facet_wrap(~Panel, nrow = 1) +
    ggplot2::coord_equal() +
    ggplot2::labs(
      title = "Sequential swara-transition probabilities",
      subtitle = "Rows show the current swara; columns show the succeeding swara",
      x = "Next swara",
      y = "Current swara"
    ) +
    ggplot2::theme_minimal(base_size = 12) +
    ggplot2::theme(
      panel.grid = ggplot2::element_blank(),
      panel.spacing = grid::unit(1.1, "lines"),
      strip.background = ggplot2::element_rect(
        fill = "#E9EEF5",
        colour = "#9AA7B2",
        linewidth = 0.5
      ),
      strip.text = ggplot2::element_text(face = "bold", size = 12),
      axis.text = ggplot2::element_text(colour = "#17202A", size = 10.5),
      axis.title = ggplot2::element_text(face = "bold"),
      plot.title = ggplot2::element_text(face = "bold", size = 15),
      plot.subtitle = ggplot2::element_text(size = 10.5, colour = "#3F4C5A"),
      legend.title = ggplot2::element_text(face = "bold"),
      legend.position = "right"
    )

  ggplot2::ggsave(
    filename = file.path(
      OUTPUT_DIR,
      "transition_heatmap_R_vs_participants.png"
    ),
    plot = transition_plot,
    width = 12,
    height = 5.8,
    units = "in",
    dpi = 600,
    bg = "white"
  )

  ggplot2::ggsave(
    filename = file.path(
      OUTPUT_DIR,
      "transition_heatmap_R_vs_participants.pdf"
    ),
    plot = transition_plot,
    width = 12,
    height = 5.8,
    units = "in",
    device = "pdf",
    bg = "white"
  )


  # -----------------------------------------------------------------------------
  # 9. COMPLETION MESSAGE
  # -----------------------------------------------------------------------------

  message("Transition analysis completed successfully.")
  message("Recordings found: ", length(recording_ids))
  message("Participant recordings found: ", length(participant_ids))
  message("Results are available in: ", normalizePath(OUTPUT_DIR))


  invisible(NULL)
}

# =============================================================================
# 5. Event-level octave contamination experiment
# =============================================================================

run_robustness_analysis <- function(settings) {
  list2env(settings$SIMULATION, envir = environment())
  REFERENCE_ID <- settings$REFERENCE_ID
  # Share the robust definitions with extraction, so changing one setting does
  # not silently give the simulation a different parameter definition.
  ROBUST_PITCH_LOWER_PROB <- settings$ANALYSIS$ROBUST_PITCH_LOWER_PROB
  ROBUST_PITCH_UPPER_PROB <- settings$ANALYSIS$ROBUST_PITCH_UPPER_PROB
  ROBUST_TRANSITION_RETAINED_PROB <- settings$ANALYSIS$ROBUST_TRANSITION_UPPER_PROB
  INPUT_CANDIDATES <- c(
    file.path(settings$OUTPUT_DIR, "all_note_events.csv"),
    "all_note_events.csv"
  )
  OUTPUT_DIR <- file.path(settings$OUTPUT_DIR, "robustness_simulation")
  CACHE_DIR <- file.path(settings$CACHE_DIR, "robustness_simulation")

  # -----------------------------------------------------------------------------
  # 2. PACKAGE AND INPUT CHECKS
  # -----------------------------------------------------------------------------

  required_packages <- c("data.table", "ggplot2")
  missing_packages <- required_packages[
    !vapply(required_packages, requireNamespace, logical(1), quietly = TRUE)
  ]

  if (length(missing_packages) > 0L) {
    stop(
      "Install the following packages before running this script: ",
      paste(missing_packages, collapse = ", "),
      "\nRun: install.packages(c(",
      paste(sprintf("\"%s\"", missing_packages), collapse = ", "),
      "))",
      call. = FALSE
    )
  }

  if (N_REPLICATES < 1L) {
    stop("N_REPLICATES must be at least 1.", call. = FALSE)
  }

  if (any(!is.finite(CONTAMINATION_RATES)) ||
      any(CONTAMINATION_RATES <= 0 | CONTAMINATION_RATES >= 1)) {
    stop("Every contamination rate must lie strictly between 0 and 1.",
         call. = FALSE)
  }

  if (!is.finite(OCTAVE_SHIFT_SEMITONES) || OCTAVE_SHIFT_SEMITONES <= 0) {
    stop("OCTAVE_SHIFT_SEMITONES must be positive.", call. = FALSE)
  }

  existing_inputs <- INPUT_CANDIDATES[file.exists(INPUT_CANDIDATES)]

  if (length(existing_inputs) == 0L) {
    stop(
      "Could not find all_note_events.csv. Place it either in the project ",
      "directory or in the output directory.",
      call. = FALSE
    )
  }

  INPUT_FILE <- existing_inputs[1L]
  INPUT_MD5 <- unname(tools::md5sum(INPUT_FILE))

  dir.create(OUTPUT_DIR, recursive = TRUE, showWarnings = FALSE)
  dir.create(CACHE_DIR, recursive = TRUE, showWarnings = FALSE)

  message("Reading note events from: ", normalizePath(INPUT_FILE))


  # -----------------------------------------------------------------------------
  # 3. SMALL UTILITY FUNCTIONS
  # -----------------------------------------------------------------------------

  safe_filename <- function(x) {
    gsub("[^A-Za-z0-9_.-]", "_", as.character(x))
  }

  save_rds_safely <- function(object, path) {
    temporary_path <- paste0(path, ".tmp")
    saveRDS(object, temporary_path, compress = TRUE)

    copied <- file.copy(temporary_path, path, overwrite = TRUE)
    unlink(temporary_path)

    if (!isTRUE(copied) || !file.exists(path)) {
      stop("Could not finalize checkpoint: ", path, call. = FALSE)
    }
  }

  weighted_quantile <- function(x, weights, probabilities) {
    keep <- is.finite(x) & is.finite(weights) & weights > 0
    x <- x[keep]
    weights <- weights[keep]

    if (length(x) == 0L) {
      return(rep(NA_real_, length(probabilities)))
    }

    if (length(x) == 1L) {
      return(rep(x, length(probabilities)))
    }

    ordering <- order(x)
    x <- x[ordering]
    weights <- weights[ordering]

    midpoint_probability <- (
      cumsum(weights) - 0.5 * weights
    ) / sum(weights)

    stats::approx(
      x = midpoint_probability,
      y = x,
      xout = probabilities,
      method = "linear",
      rule = 2,
      ties = "ordered"
    )$y
  }

  calculate_pitch_parameters <- function(pitch, duration) {
    keep <- is.finite(pitch) & is.finite(duration) & duration > 0
    pitch <- pitch[keep]
    duration <- duration[keep]

    if (length(pitch) < 2L) {
      stop("At least two valid events are required for P3.", call. = FALSE)
    }

    conventional_p1 <- (
      sum(pitch * duration) / sum(duration)
    ) - min(pitch)
    conventional_p2 <- max(pitch) - min(pitch)

    transitions <- abs(diff(pitch))
    conventional_p3 <- mean(transitions)

    pitch_quantiles <- weighted_quantile(
      pitch,
      duration,
      c(ROBUST_PITCH_LOWER_PROB, ROBUST_PITCH_UPPER_PROB)
    )

    pitch_q05 <- pitch_quantiles[1L]
    pitch_q95 <- pitch_quantiles[2L]
    winsorised_pitch <- pmin(pmax(pitch, pitch_q05), pitch_q95)

    robust_p1 <- (
      sum(winsorised_pitch * duration) / sum(duration)
    ) - pitch_q05
    robust_p2 <- pitch_q95 - pitch_q05

    retained_transition_count <- max(
      1L,
      as.integer(ceiling(
        ROBUST_TRANSITION_RETAINED_PROB * length(transitions)
      ))
    )

    robust_p3 <- mean(
      sort(transitions)[seq_len(retained_transition_count)]
    )

    c(
      P1_Conventional = conventional_p1,
      P1_Robust = robust_p1,
      P2_Conventional = conventional_p2,
      P2_Robust = robust_p2,
      P3_Conventional = conventional_p3,
      P3_Robust = robust_p3
    )
  }

  metric_information <- data.table::data.table(
    Metric = c(
      "P1_Conventional", "P1_Robust",
      "P2_Conventional", "P2_Robust",
      "P3_Conventional", "P3_Robust"
    ),
    Parameter = rep(c("P1", "P2", "P3"), each = 2L),
    Method = rep(c("Conventional", "Robust"), 3L)
  )

  checkpoint_path <- function(recording_id) {
    file.path(
      CACHE_DIR,
      paste0(safe_filename(recording_id), "_robustness_simulation.rds")
    )
  }

  make_signature <- function(recording_id, n_events) {
    recording_seed <- as.integer(
      SIMULATION_SEED +
        sum(utf8ToInt(as.character(recording_id)) *
              seq_along(utf8ToInt(as.character(recording_id))))
    )

    list(
      simulation_version = SIMULATION_VERSION,
      input_md5 = INPUT_MD5,
      recording_id = as.character(recording_id),
      n_events = as.integer(n_events),
      global_seed = as.integer(SIMULATION_SEED),
      recording_seed = recording_seed,
      include_reference = as.logical(INCLUDE_REFERENCE),
      n_replicates = as.integer(N_REPLICATES),
      contamination_rates = as.numeric(CONTAMINATION_RATES),
      octave_shift_semitones = as.numeric(OCTAVE_SHIFT_SEMITONES),
      robust_pitch_lower_probability = as.numeric(ROBUST_PITCH_LOWER_PROB),
      robust_pitch_upper_probability = as.numeric(ROBUST_PITCH_UPPER_PROB),
      robust_transition_retained_probability = as.numeric(
        ROBUST_TRANSITION_RETAINED_PROB
      )
    )
  }

  read_valid_checkpoint <- function(recording_id, n_events) {
    path <- checkpoint_path(recording_id)

    if (!file.exists(path)) {
      return(NULL)
    }

    checkpoint <- tryCatch(readRDS(path), error = function(e) NULL)

    if (is.null(checkpoint) || !is.list(checkpoint)) {
      return(NULL)
    }

    if (!all(c("signature", "baseline", "replicates") %in% names(checkpoint))) {
      return(NULL)
    }

    if (!identical(
      checkpoint$signature,
      make_signature(recording_id, n_events)
    )) {
      return(NULL)
    }

    checkpoint
  }


  # -----------------------------------------------------------------------------
  # 4. READ AND VALIDATE THE EVENT DATA
  # -----------------------------------------------------------------------------

  events <- data.table::fread(INPUT_FILE)

  required_columns <- c(
    "recording_id", "Event_ID", "Duration", "Pitch_Semitones"
  )
  missing_columns <- setdiff(required_columns, names(events))

  if (length(missing_columns) > 0L) {
    stop(
      "The event file is missing: ",
      paste(missing_columns, collapse = ", "),
      call. = FALSE
    )
  }

  events[, recording_id := as.character(recording_id)]
  events[, Event_ID := as.integer(Event_ID)]
  events[, Duration := as.numeric(Duration)]
  events[, Pitch_Semitones := as.numeric(Pitch_Semitones)]

  if (anyNA(events[, .(
    recording_id, Event_ID, Duration, Pitch_Semitones
  )])) {
    stop("Required event columns contain missing values.", call. = FALSE)
  }

  if (any(!is.finite(events$Duration) | events$Duration <= 0)) {
    stop("All event durations must be finite and positive.", call. = FALSE)
  }

  if (any(!is.finite(events$Pitch_Semitones))) {
    stop("All event pitches must be finite.", call. = FALSE)
  }

  if (events[, anyDuplicated(paste(recording_id, Event_ID))] > 0L) {
    stop("Event_ID values must be unique within each recording.", call. = FALSE)
  }

  if (!INCLUDE_REFERENCE) {
    events <- events[recording_id != REFERENCE_ID]
  }

  if (nrow(events) == 0L) {
    stop("No events remain after applying the inclusion settings.", call. = FALSE)
  }

  event_counts <- events[, .(N_Events = .N), by = recording_id]

  if (any(event_counts$N_Events < 2L)) {
    stop(
      "Every included recording must contain at least two note events.",
      call. = FALSE
    )
  }

  participant_ids <- sort(setdiff(unique(events$recording_id), REFERENCE_ID))
  recording_ids <- c(
    if (REFERENCE_ID %in% events$recording_id) REFERENCE_ID else character(),
    participant_ids
  )

  data.table::setorder(events, recording_id, Event_ID)


  # -----------------------------------------------------------------------------
  # 5. RECORDING-LEVEL MONTE CARLO SIMULATION
  # -----------------------------------------------------------------------------

  status <- data.table::data.table(
    recording_id = recording_ids,
    status = "pending",
    message = "",
    checkpoint = vapply(recording_ids, checkpoint_path, character(1))
  )

  status_path <- file.path(CACHE_DIR, "simulation_status.csv")
  data.table::fwrite(status, status_path)

  for (recording_index in seq_along(recording_ids)) {
    current_id <- recording_ids[recording_index]
    current_events <- events[recording_id == current_id]
    data.table::setorder(current_events, Event_ID)

    n_events <- nrow(current_events)
    pitch <- current_events$Pitch_Semitones
    duration <- current_events$Duration

    use_cache <- !FORCE_REPROCESS &&
      !(current_id %in% REPROCESS_IDS)

    checkpoint <- if (use_cache) {
      read_valid_checkpoint(current_id, n_events)
    } else {
      NULL
    }

    if (!is.null(checkpoint)) {
      message("Using cached simulation for ", current_id, " ...")
      status[recording_id == current_id, `:=`(
        status = "cached",
        message = "Valid recording-level simulation checkpoint reused."
      )]
      data.table::fwrite(status, status_path)
      next
    }

    message("Simulating octave contamination for ", current_id, " ...")
    status[recording_id == current_id, `:=`(
      status = "processing",
      message = "Monte Carlo simulation in progress."
    )]
    data.table::fwrite(status, status_path)

    simulation_result <- tryCatch(
      {
        baseline <- calculate_pitch_parameters(pitch, duration)

        # The recording-specific seed makes results reproducible even when a
        # previous run is resumed from checkpoints.
        set.seed(make_signature(current_id, n_events)$recording_seed)

        rate_results <- vector("list", length(CONTAMINATION_RATES))

        for (rate_index in seq_along(CONTAMINATION_RATES)) {
          contamination_rate <- CONTAMINATION_RATES[rate_index]
          contaminated_count <- max(
            1L,
            as.integer(ceiling(contamination_rate * n_events))
          )

          result_matrix <- matrix(
            NA_real_,
            nrow = N_REPLICATES,
            ncol = length(baseline),
            dimnames = list(NULL, names(baseline))
          )

          for (replicate_id in seq_len(N_REPLICATES)) {
            contaminated_pitch <- pitch
            selected_events <- sample.int(
              n_events,
              size = contaminated_count,
              replace = FALSE
            )
            shift_direction <- sample(
              c(-1, 1),
              size = contaminated_count,
              replace = TRUE
            )

            contaminated_pitch[selected_events] <-
              contaminated_pitch[selected_events] +
              shift_direction * OCTAVE_SHIFT_SEMITONES

            result_matrix[replicate_id, ] <- calculate_pitch_parameters(
              contaminated_pitch,
              duration
            )
          }

          rate_results[[rate_index]] <- data.table::as.data.table(result_matrix)
          rate_results[[rate_index]][, `:=`(
            recording_id = current_id,
            contamination_rate = contamination_rate,
            actual_contamination_rate = contaminated_count / n_events,
            contaminated_events = contaminated_count,
            replicate = seq_len(N_REPLICATES)
          )]

          data.table::setcolorder(
            rate_results[[rate_index]],
            c(
              "recording_id", "contamination_rate",
              "actual_contamination_rate", "contaminated_events",
              "replicate", names(baseline)
            )
          )
        }

        list(
          signature = make_signature(current_id, n_events),
          baseline = baseline,
          replicates = data.table::rbindlist(rate_results, use.names = TRUE),
          completed_at = format(Sys.time(), tz = "UTC", usetz = TRUE)
        )
      },
      error = function(e) e
    )

    if (inherits(simulation_result, "error")) {
      status[recording_id == current_id, `:=`(
        status = "failed",
        message = conditionMessage(simulation_result)
      )]
      data.table::fwrite(status, status_path)
      stop(
        "Robustness simulation failed for ", current_id, ": ",
        conditionMessage(simulation_result),
        "\nCompleted recording checkpoints were preserved.",
        call. = FALSE
      )
    }

    save_rds_safely(
      simulation_result,
      checkpoint_path(current_id)
    )

    status[recording_id == current_id, `:=`(
      status = "processed",
      message = "Simulation checkpoint created successfully."
    )]
    data.table::fwrite(status, status_path)
  }


  # -----------------------------------------------------------------------------
  # 6. COMBINE CHECKPOINTS AND CALCULATE CHANGES FROM CLEAN BASELINES
  # -----------------------------------------------------------------------------

  checkpoints <- lapply(recording_ids, function(current_id) {
    current_n <- event_counts[recording_id == current_id, N_Events]
    checkpoint <- read_valid_checkpoint(current_id, current_n)

    if (is.null(checkpoint)) {
      stop("A valid final checkpoint is missing for ", current_id,
           call. = FALSE)
    }

    checkpoint
  })

  baseline_table <- data.table::rbindlist(
    lapply(seq_along(recording_ids), function(index) {
      values <- checkpoints[[index]]$baseline
      data.table::data.table(
        recording_id = recording_ids[index],
        Metric = names(values),
        Baseline_Value = as.numeric(values)
      )
    })
  )

  baseline_table <- merge(
    baseline_table,
    metric_information,
    by = "Metric",
    all.x = TRUE,
    sort = FALSE
  )

  replicate_wide <- data.table::rbindlist(
    lapply(checkpoints, function(x) x$replicates),
    use.names = TRUE
  )

  replicate_long <- data.table::melt(
    replicate_wide,
    id.vars = c(
      "recording_id", "contamination_rate",
      "actual_contamination_rate", "contaminated_events", "replicate"
    ),
    measure.vars = metric_information$Metric,
    variable.name = "Metric",
    value.name = "Contaminated_Value"
  )

  replicate_long <- merge(
    replicate_long,
    baseline_table,
    by = c("recording_id", "Metric"),
    all.x = TRUE,
    sort = FALSE
  )

  replicate_long <- merge(
    replicate_long,
    event_counts,
    by = "recording_id",
    all.x = TRUE,
    sort = FALSE
  )

  replicate_long[, Signed_Change := Contaminated_Value - Baseline_Value]
  replicate_long[, Absolute_Change := abs(Signed_Change)]
  replicate_long[, Relative_Change_Percent := 100 * Absolute_Change /
                   pmax(abs(Baseline_Value), sqrt(.Machine$double.eps))]


  # -----------------------------------------------------------------------------
  # 7. RECORDING-LEVEL AND OVERALL ROBUSTNESS SUMMARIES
  # -----------------------------------------------------------------------------

  recording_summary <- replicate_long[, .(
    N_Replicates = .N,
    N_Events = unique(N_Events),
    Actual_Contamination_Rate = unique(actual_contamination_rate),
    Contaminated_Events = unique(contaminated_events),
    Baseline_Value = unique(Baseline_Value),
    Median_Signed_Change = stats::median(Signed_Change),
    Median_Absolute_Change = stats::median(Absolute_Change),
    IQR_Absolute_Change = stats::IQR(Absolute_Change),
    Q95_Absolute_Change = unname(stats::quantile(
      Absolute_Change,
      probs = 0.95,
      names = FALSE,
      type = 7
    )),
    RMSE_Change = sqrt(mean(Signed_Change^2)),
    Median_Relative_Change_Percent = stats::median(
      Relative_Change_Percent
    ),
    IQR_Relative_Change_Percent = stats::IQR(Relative_Change_Percent),
    Proportion_Relative_Change_GT_10pct = mean(
      Relative_Change_Percent > RELATIVE_CHANGE_WARNING_PERCENT
    )
  ), by = .(
    recording_id,
    contamination_rate,
    Metric,
    Parameter,
    Method
  )]

  overall_summary <- recording_summary[, .(
    N_Recordings = .N,
    Median_Recording_Median_Absolute_Change = stats::median(
      Median_Absolute_Change
    ),
    Q1_Recording_Median_Absolute_Change = unname(stats::quantile(
      Median_Absolute_Change, 0.25, names = FALSE
    )),
    Q3_Recording_Median_Absolute_Change = unname(stats::quantile(
      Median_Absolute_Change, 0.75, names = FALSE
    )),
    Median_Recording_RMSE_Change = stats::median(RMSE_Change),
    Median_Recording_Median_Relative_Change_Percent = stats::median(
      Median_Relative_Change_Percent
    ),
    Q1_Recording_Median_Relative_Change_Percent = unname(stats::quantile(
      Median_Relative_Change_Percent, 0.25, names = FALSE
    )),
    Q3_Recording_Median_Relative_Change_Percent = unname(stats::quantile(
      Median_Relative_Change_Percent, 0.75, names = FALSE
    )),
    Mean_Proportion_Relative_Change_GT_10pct = mean(
      Proportion_Relative_Change_GT_10pct
    )
  ), by = .(
    contamination_rate,
    Metric,
    Parameter,
    Method
  )]

  # Structural validation: one summary row is required for every
  # recording x contamination rate x metric combination.
  expected_recording_rows <- length(recording_ids) *
    length(CONTAMINATION_RATES) * nrow(metric_information)

  if (nrow(recording_summary) != expected_recording_rows) {
    stop(
      paste0(
        "Recording-level robustness summary has ",
        nrow(recording_summary), " rows; expected ",
        expected_recording_rows, "."
      ),
      call. = FALSE
    )
  }

  if (recording_summary[, anyDuplicated(
    paste(recording_id, contamination_rate, Metric, sep = "|")
  )] > 0L) {
    stop(
      "Recording-level robustness summary contains duplicate keys.",
      call. = FALSE
    )
  }

  expected_overall_rows <- length(CONTAMINATION_RATES) *
    nrow(metric_information)

  if (nrow(overall_summary) != expected_overall_rows ||
      any(overall_summary$N_Recordings != length(recording_ids))) {
    stop(
      paste0(
        "Overall robustness summary failed structural validation; ",
        "each row must represent all ", length(recording_ids),
        " recordings."
      ),
      call. = FALSE
    )
  }

  data.table::setorder(
    recording_summary,
    Parameter,
    Method,
    contamination_rate,
    recording_id
  )
  data.table::setorder(
    overall_summary,
    Parameter,
    Method,
    contamination_rate
  )

  gain_wide <- data.table::dcast(
    overall_summary,
    Parameter + contamination_rate ~ Method,
    value.var = "Median_Recording_Median_Relative_Change_Percent"
  )

  gain_wide[, Robustness_Gain_Ratio := data.table::fifelse(
    is.finite(Robust) & Robust > 0,
    Conventional / Robust,
    NA_real_
  )]
  data.table::setorder(gain_wide, Parameter, contamination_rate)


  # -----------------------------------------------------------------------------
  # 8. WRITE NUMERICAL OUTPUTS
  # -----------------------------------------------------------------------------

  data.table::fwrite(
    baseline_table,
    file.path(OUTPUT_DIR, "baseline_pitch_parameters.csv")
  )

  data.table::fwrite(
    recording_summary,
    file.path(OUTPUT_DIR, "recording_level_robustness_summary.csv")
  )

  data.table::fwrite(
    overall_summary,
    file.path(OUTPUT_DIR, "overall_robustness_summary.csv")
  )

  data.table::fwrite(
    gain_wide,
    file.path(OUTPUT_DIR, "robustness_gain.csv")
  )

  saveRDS(
    replicate_wide,
    file.path(OUTPUT_DIR, "simulation_replicate_results.rds"),
    compress = TRUE
  )

  simulation_settings <- data.table::data.table(
    Setting = c(
      "Simulation version",
      "Input file",
      "Input MD5",
      "Number of recordings",
      "Include reference",
      "Monte Carlo repetitions per rate and recording",
      "Contamination rates",
      "Pitch shift (semitones)",
      "Event selection",
      "Shift direction",
      "Robust pitch lower quantile",
      "Robust pitch upper quantile",
      "Robust transition retained proportion",
      "Relative-change warning threshold (percent)",
      "Random seed"
    ),
    Value = c(
      SIMULATION_VERSION,
      normalizePath(INPUT_FILE, winslash = "/"),
      INPUT_MD5,
      as.character(length(recording_ids)),
      as.character(INCLUDE_REFERENCE),
      as.character(N_REPLICATES),
      paste(CONTAMINATION_RATES, collapse = ", "),
      as.character(OCTAVE_SHIFT_SEMITONES),
      "Uniform without replacement",
      paste0(
        "-", OCTAVE_SHIFT_SEMITONES, " or +", OCTAVE_SHIFT_SEMITONES,
        " semitones with equal probability"
      ),
      as.character(ROBUST_PITCH_LOWER_PROB),
      as.character(ROBUST_PITCH_UPPER_PROB),
      as.character(ROBUST_TRANSITION_RETAINED_PROB),
      as.character(RELATIVE_CHANGE_WARNING_PERCENT),
      as.character(SIMULATION_SEED)
    )
  )

  data.table::fwrite(
    simulation_settings,
    file.path(OUTPUT_DIR, "simulation_settings.csv")
  )

  writeLines(
    capture.output(utils::sessionInfo()),
    file.path(OUTPUT_DIR, "session_info.txt")
  )


  # -----------------------------------------------------------------------------
  # 9. PUBLICATION FIGURE
  # -----------------------------------------------------------------------------

  zero_rows <- unique(
    overall_summary[, .(Parameter, Method)]
  )
  zero_rows[, `:=`(
    contamination_rate = 0,
    Median_Recording_Median_Relative_Change_Percent = 0,
    Q1_Recording_Median_Relative_Change_Percent = 0,
    Q3_Recording_Median_Relative_Change_Percent = 0
  )]

  plot_data <- data.table::rbindlist(
    list(
      zero_rows,
      overall_summary[, .(
        Parameter,
        Method,
        contamination_rate,
        Median_Recording_Median_Relative_Change_Percent,
        Q1_Recording_Median_Relative_Change_Percent,
        Q3_Recording_Median_Relative_Change_Percent
      )]
    ),
    use.names = TRUE,
    fill = TRUE
  )

  plot_data[, Contamination_Percent := 100 * contamination_rate]
  plot_data[, Parameter := factor(Parameter, levels = c("P1", "P2", "P3"))]
  plot_data[, Method := factor(
    Method,
    levels = c("Conventional", "Robust")
  )]

  robustness_plot <- ggplot2::ggplot(
    plot_data,
    ggplot2::aes(
      x = Contamination_Percent,
      y = Median_Recording_Median_Relative_Change_Percent,
      colour = Method,
      fill = Method,
      group = Method
    )
  ) +
    ggplot2::geom_ribbon(
      ggplot2::aes(
        ymin = Q1_Recording_Median_Relative_Change_Percent,
        ymax = Q3_Recording_Median_Relative_Change_Percent
      ),
      alpha = 0.14,
      colour = NA
    ) +
    ggplot2::geom_line(linewidth = 1.05) +
    ggplot2::geom_point(size = 2.6) +
    ggplot2::facet_wrap(~Parameter, nrow = 1) +
    ggplot2::scale_colour_manual(
      values = c("Conventional" = "#C0392B", "Robust" = "#2166AC")
    ) +
    ggplot2::scale_fill_manual(
      values = c("Conventional" = "#C0392B", "Robust" = "#2166AC")
    ) +
    ggplot2::scale_x_continuous(
      breaks = c(0, 1, 2.5, 5, 10),
      labels = c("0", "1", "2.5", "5", "10")
    ) +
    ggplot2::labs(
      title = "Robustness to simulated octave-tracking errors",
      subtitle = paste0(
        "Lines: median of recording-specific Monte Carlo summaries; ",
        "bands: interquartile range"
      ),
      x = "Contaminated note events (%)",
      y = "Median relative change from baseline (%)",
      colour = "Parameter form",
      fill = "Parameter form"
    ) +
    ggplot2::theme_minimal(base_size = 12) +
    ggplot2::theme(
      panel.grid.minor = ggplot2::element_blank(),
      panel.grid.major.x = ggplot2::element_blank(),
      strip.background = ggplot2::element_rect(
        fill = "#E9EEF5",
        colour = "#9AA7B2",
        linewidth = 0.5
      ),
      strip.text = ggplot2::element_text(face = "bold", size = 12),
      axis.title = ggplot2::element_text(face = "bold"),
      plot.title = ggplot2::element_text(face = "bold", size = 15),
      plot.subtitle = ggplot2::element_text(size = 10.5, colour = "#3F4C5A"),
      legend.title = ggplot2::element_text(face = "bold"),
      legend.position = "bottom"
    )

  ggplot2::ggsave(
    filename = file.path(
      OUTPUT_DIR,
      "robustness_simulation_relative_change.png"
    ),
    plot = robustness_plot,
    width = 12,
    height = 5.2,
    units = "in",
    dpi = 600,
    bg = "white"
  )

  ggplot2::ggsave(
    filename = file.path(
      OUTPUT_DIR,
      "robustness_simulation_relative_change.pdf"
    ),
    plot = robustness_plot,
    width = 12,
    height = 5.2,
    units = "in",
    device = "pdf",
    bg = "white"
  )


  # -----------------------------------------------------------------------------
  # 10. COMPLETION MESSAGE
  # -----------------------------------------------------------------------------

  status[status == "processed" | status == "cached", status := "complete"]
  data.table::fwrite(status, status_path)

  message("Robustness simulation completed successfully.")
  message("Recordings included: ", length(recording_ids))
  message("Replicates per rate and recording: ", N_REPLICATES)
  message("Contamination rates: ", paste(100 * CONTAMINATION_RATES, collapse = ", "), "%")
  message("Results are available in: ", normalizePath(OUTPUT_DIR))

  invisible(NULL)
}

# =============================================================================
# 6. Distribution ranking figure and rank agreement
# =============================================================================
# This replaces the separate plotting step. It reads the exported distances;
# it does not alter the underlying swara distributions or distances.

run_distribution_report <- function(settings) {
  for (package in c("data.table", "ggplot2")) {
    if (!requireNamespace(package, quietly = TRUE)) {
      stop("Install the R package '", package, "' before making reports.",
           call. = FALSE)
    }
  }
  candidates <- c(
    file.path(settings$OUTPUT_DIR, "bhattacharyya_distances.csv"),
    "bhattacharyya_distances.csv"
  )
  available <- candidates[file.exists(candidates)]
  if (length(available) == 0L) {
    stop("Missing bhattacharyya_distances.csv; run analysis first or supply the table.",
         call. = FALSE)
  }
  distances <- data.table::fread(available[1L])
  columns <- c("recording_id", "BD_duration", "BD_count")
  if (!all(columns %in% names(distances))) {
    stop("The distance table requires recording_id, BD_duration and BD_count.",
         call. = FALSE)
  }
  distances <- distances[recording_id != settings$REFERENCE_ID]
  if (nrow(distances) == 0L) {
    message("No participant distances are available; distance report skipped.")
    return(invisible(NULL))
  }
  if (anyNA(distances[, ..columns]) || anyDuplicated(distances$recording_id) ||
      any(!is.finite(distances$BD_duration)) ||
      any(!is.finite(distances$BD_count)) ||
      any(distances$BD_duration < 0 | distances$BD_count < 0)) {
    stop("Distance values must be finite and nonnegative, with unique recording IDs.",
         call. = FALSE)
  }

  data.table::setorder(distances, BD_duration, recording_id)
  distances[, Recording := factor(recording_id, levels = rev(recording_id))]
  plot <- ggplot2::ggplot(distances, ggplot2::aes(y = Recording)) +
    ggplot2::geom_segment(
      ggplot2::aes(x = 0, xend = BD_duration, yend = Recording),
      colour = "#D9DEE7", linewidth = 0.45
    ) +
    ggplot2::geom_point(
      ggplot2::aes(x = BD_duration, colour = "Duration weighted"), size = 2.3
    ) +
    ggplot2::geom_point(
      ggplot2::aes(x = BD_count, colour = "Event count"),
      shape = 5, size = 2.2, stroke = 0.8
    ) +
    ggplot2::scale_colour_manual(
      values = c("Duration weighted" = "#1F6AA5", "Event count" = "#C43D2B")
    ) +
    ggplot2::scale_x_continuous(limits = c(0, NA)) +
    ggplot2::labs(
      x = paste("Bhattacharyya distance from reference", settings$REFERENCE_ID),
      y = "Participant recording", colour = NULL
    ) +
    ggplot2::theme_minimal(base_size = 11) +
    ggplot2::theme(
      panel.grid.major.y = ggplot2::element_blank(),
      panel.grid.minor = ggplot2::element_blank(),
      legend.position = "bottom"
    )
  directory <- file.path(settings$OUTPUT_DIR, "plots")
  dir.create(directory, recursive = TRUE, showWarnings = FALSE)
  for (extension in c("png", "pdf")) {
    ggplot2::ggsave(
      file.path(directory, paste0("bhattacharyya_ranked_all_recordings.", extension)),
      plot = plot, width = 7.2, height = max(4, 0.20 * nrow(distances) + 1.6),
      units = "in", dpi = 300, bg = "white"
    )
  }

  # Average ranks handle ties. No hypothesis test is attached to this
  # descriptive comparison of the two ways of weighting swara usage.
  rho <- if (nrow(distances) >= 2L &&
             stats::sd(distances$BD_count) > 0 &&
             stats::sd(distances$BD_duration) > 0) {
    stats::cor(distances$BD_count, distances$BD_duration, method = "spearman")
  } else {
    NA_real_
  }
  data.table::fwrite(
    data.table::data.table(
      N_Participants = nrow(distances), Spearman_Rho = rho,
      Description = "Count-weighted versus duration-weighted distances"
    ),
    file.path(settings$OUTPUT_DIR, "bhattacharyya_rank_agreement.csv")
  )
  invisible(NULL)
}


# =============================================================================
# 7. Run the requested stages
# =============================================================================

run_kafi <- function(settings = KAFI_SETTINGS, mode = settings$MODE) {
  allowed_modes <- c("all", "analysis", "process", "summarize", "downstream",
                     "transitions", "simulation", "distances")
  mode <- match.arg(mode, allowed_modes)
  if (!dir.exists(settings$PROJECT_DIR)) {
    stop("Project directory does not exist: ", settings$PROJECT_DIR, call. = FALSE)
  }
  previous_directory <- getwd()
  on.exit(setwd(previous_directory), add = TRUE)
  setwd(settings$PROJECT_DIR)

  # Reject invalid quantile settings before they enter either parameter stage.
  lower <- settings$ANALYSIS$ROBUST_PITCH_LOWER_PROB
  upper <- settings$ANALYSIS$ROBUST_PITCH_UPPER_PROB
  retained <- settings$ANALYSIS$ROBUST_TRANSITION_UPPER_PROB
  if (length(lower) != 1L || length(upper) != 1L || length(retained) != 1L ||
      !is.finite(lower) || !is.finite(upper) || !is.finite(retained) ||
      lower < 0 || upper > 1 || lower >= upper || retained <= 0 || retained > 1) {
    stop("Require 0 <= lower quantile < upper quantile <= 1 and 0 < retained <= 1.",
         call. = FALSE)
  }

  message("Kafi analysis mode: ", mode)
  if (mode %in% c("all", "analysis", "process", "summarize")) {
    stage <- if (mode == "process") "process" else
      if (mode == "summarize") "summarize" else "both"
    run_note_analysis(settings, stage = stage)
  }
  if (mode %in% c("all", "transitions", "downstream")) {
    run_transition_analysis(settings)
  }
  if (mode %in% c("all", "simulation", "downstream")) {
    run_robustness_analysis(settings)
  }
  if (mode %in% c("all", "analysis", "summarize", "distances")) {
    run_distribution_report(settings)
  }
  if (mode == "downstream") {
    if (any(file.exists(c(
      file.path(settings$OUTPUT_DIR, "bhattacharyya_distances.csv"),
      "bhattacharyya_distances.csv"
    )))) {
      run_distribution_report(settings)
    } else {
      message("No distance table supplied; the optional distance plot is skipped.")
    }
  }

  # Save the combined configuration as well as the existing stage-specific
  # setting tables. These files record a run; they are not read as configuration.
  dir.create(settings$OUTPUT_DIR, recursive = TRUE, showWarnings = FALSE)
  saved_settings <- settings
  saved_settings$MODE <- mode
  dput(saved_settings, file = file.path(settings$OUTPUT_DIR, "combined_run_settings.R"))
  writeLines(
    capture.output(sessionInfo()),
    file.path(settings$OUTPUT_DIR, "combined_R_session_info.txt")
  )
  if (file.exists(settings$SCRIPT_FILE)) {
    writeLines(
      paste(unname(tools::md5sum(settings$SCRIPT_FILE)), settings$SCRIPT_FILE),
      file.path(settings$OUTPUT_DIR, "combined_script_md5.txt")
    )
  }
  message("Requested stages complete. Outputs: ", normalizePath(settings$OUTPUT_DIR))
  invisible(settings)
}

# RStudio: source the file normally, or set options(kafi.autorun = FALSE) to
# load functions first and call run_kafi() with your own settings.
# Command line: Rscript Kafi_Complete_Analysis.R --mode=downstream
if (isTRUE(getOption("kafi.autorun", TRUE))) {
  execution_settings <- KAFI_SETTINGS
  requested_mode <- getOption("kafi.mode", execution_settings$MODE)
  requested_project <- getOption("kafi.project", execution_settings$PROJECT_DIR)
  for (argument in commandArgs(trailingOnly = TRUE)) {
    if (startsWith(argument, "--mode=")) {
      requested_mode <- substring(argument, nchar("--mode=") + 1L)
    } else if (startsWith(argument, "--project=")) {
      requested_project <- substring(argument, nchar("--project=") + 1L)
    }
  }
  execution_settings$PROJECT_DIR <- requested_project
  run_kafi(execution_settings, mode = requested_mode)
}
